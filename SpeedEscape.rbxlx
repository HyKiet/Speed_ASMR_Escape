					New("UIScale")({
						Scale = Tween(Computed(function()
							return if rebirthCloseHovered:get() then 1.08 else 1
						end), TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)),
					}),
