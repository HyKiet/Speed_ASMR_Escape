					New("Frame")({
						BackgroundColor3 = Color3.fromRGB(242, 199, 132),
						BorderSizePixel = 0,
						Size = Computed(function()
							local state = getSnapshot()
							local progress = 0
							if state.requiredXP > 0 then
								progress = math.clamp(state.xp / state.requiredXP, 0, 1)
							end
							if state.xp > 0 then
