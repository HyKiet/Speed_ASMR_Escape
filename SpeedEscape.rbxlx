  <Item class="ServerScriptService" referent="125">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Script" referent="126">
      <Properties>
        <string name="Name">Server</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[--!strict -- Bật chế độ Type Checking nghiêm ngặt của Luau (ngôn ngữ lập trình của Roblox). Giúp phát hiện lỗi sớm trước khi chạy game!

-- Bộ khởi chạy Server Modular (Custom Bootstrapper)
-- Đây là "trái tim" của Server. Thay vì chạy nhiều script riêng lẻ, file này tự động tìm và chạy tất cả Services (dịch vụ).

-- script:WaitForChild("Services") dùng để tìm thư mục có tên "Services" nằm bên trong script này.
-- WaitForChild là một cách an toàn để lấy Instance vì nó sẽ đợi cho đến khi Instance đó được tải xong hoàn toàn.
local ServicesFolder = script:WaitForChild("Services")

print("--- [SERVER LOADING] Bắt đầu nạp các dịch vụ trên Server... ---")

-- Khởi tạo bảng (table) trống để lưu trữ các dịch vụ đã tải thành công.
local Services = {}

-- ============================================================================
-- GIAI ĐOẠN 1: QUÉT VÀ NẠP TẤT CẢ MODULESCRIPT TRONG THƯ MỤC SERVICES
-- ============================================================================
-- GetChildren() lấy ra danh sách tất cả các đối tượng con nằm trực tiếp trong thư mục ServicesFolder.
for _, module in ServicesFolder:GetChildren() do
	-- Kiểm tra xem đối tượng con đó có đúng là kiểu "ModuleScript" hay không.
	if module:IsA("ModuleScript") then
		-- pcall (Protected Call) chạy hàm require(module) trong một chế độ an toàn.
		-- Nếu ModuleScript có lỗi cú pháp hoặc bị crash, pcall sẽ bắt lỗi đó và trả về success = false mà không làm crash toàn bộ Server.
		-- require() là hàm dùng để nạp nội dung của một ModuleScript và trả về giá trị (thường là một table).
		local success, service = pcall(require, module)
		if success then
			-- Lưu dịch vụ vào bảng Services với tên của file làm khóa (Key).
			Services[module.Name] = service
		else
			-- Nếu có lỗi, cảnh báo (warn) sẽ in ra màn hình Output màu cam nhưng không làm gián đoạn game.
			warn("[SERVER ERROR] Lỗi nạp dịch vụ: " .. module.Name .. " | Chi tiết lỗi: " .. tostring(service))
		end
	end
end

-- ============================================================================
-- GIAI ĐOẠN 2: KHỞI TẠO (INIT)
-- ============================================================================
-- Vòng lặp này chạy qua tất cả các dịch vụ đã nạp thành công ở Giai đoạn 1.
for name, service in Services do
	-- Kiểm tra xem trong dịch vụ đó có định nghĩa hàm tên là "Init" hay không.
	if type(service.Init) == "function" then
		-- Chạy hàm Init() trong chế độ an toàn pcall.
		-- Init là nơi chúng ta thiết lập biến ban đầu, tạo RemoteEvent, nạp cấu hình,... (không chứa logic chạy lâu dài).
		local success, err = pcall(service.Init)
		if not success then
			warn("[SERVER ERROR] Lỗi Khởi tạo (Init) dịch vụ: " .. name .. " | Chi tiết lỗi: " .. tostring(err))
		end
	end
end

-- ============================================================================
-- GIAI ĐOẠN 3: BẮT ĐẦU CHẠY LOGIC GAME (START)
-- ============================================================================
for name, service in Services do
	-- Kiểm tra xem trong dịch vụ đó có hàm "Start" hay không.
	if type(service.Start) == "function" then
		-- Sử dụng task.spawn để chạy hàm Start() trong một luồng (thread) chạy song song riêng biệt.
		-- task.spawn() là thư viện quản lý tác vụ hiện đại nhất của Roblox (thay thế cho spawn() cũ lỗi thời).
		-- Nó đảm bảo nếu một dịch vụ bị dừng hoặc chạy vòng lặp vô hạn, nó cũng KHÔNG làm đóng băng các dịch vụ khác.
		task.spawn(function()
			local success, err = pcall(service.Start)
			if not success then
				warn("[SERVER ERROR] Lỗi Bắt đầu (Start) dịch vụ: " .. name .. " | Chi tiết lỗi: " .. tostring(err))
			end
		end)
	end
end

print("--- [SERVER READY] Tất cả các dịch vụ trên Server đã được nạp thành công! ---")

]]></string>
      </Properties>
      <Item class="Folder" referent="127">
        <Properties>
          <string name="Name">Services</string>
        </Properties>
        <Item class="ModuleScript" referent="128">
          <Properties>
            <string name="Name">BossChaseService</string>
            <string name="Source"><![CDATA[--!strict

local Players = game:GetService("Players")
local ContentProvider = game:GetService("ContentProvider")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local BossChaseService = {}

local ZONE_NAME = "Zone4"
local MECHANICS_NAME = "Mechanics"
local ARENA_FLOOR_NAME = "BossArenaFloor"
local START_GATE_NAME = "Stage4Start"
local FINISH_GATE_NAME = "Stage4Finish"
local KILL_FLOOR_NAME = "KillFloor"
local LEGACY_CONTROLLER_NAME = "Zone4Controller"

local BOSS_NAME = "MonkeyBoss"
local RUN_ANIMATION_ID = "rbxassetid://125733527624272"

local STAGE_NUMBER = 4
local COMPLETE_STAGE = 5

local CHASE_SPEED = 56
local RETURN_SPEED = 72
local TOUCH_KILL_DISTANCE = 3.75
local KILL_COOLDOWN_SECONDS = 1.15
local BOSS_PIVOT_Y = 11.588234901428223
local VISUAL_REPAIR_INTERVAL = 1.25
local VISUAL_DRIFT_DISTANCE = 10
local ARENA_DETECTION_PADDING = 4
local DEBUG_ATTRIBUTE_INTERVAL = 0.5

local HOME_PIVOT = CFrame.new(-4.211, 11.588, 1568.629)

local ARENA_MIN_X = -139
local ARENA_MAX_X = 131
local ARENA_MIN_Z = 1391
local ARENA_MAX_Z = 1746

local zone: Folder?
local mechanics: Folder?
local startGate: BasePart?
local finishGate: BasePart?
local killFloor: BasePart?
local boss: Model?
local bossTemplate: Model?
local runTrack: AnimationTrack?
local runTrackBoss: Model?
local runAnimation = Instance.new("Animation")
local lastVisualRepairTime = 0
local lastDebugAttributeTime = 0
local heartbeatTicks = 0
local lastKillTimes: { [Player]: number } = {}
local activeEncounterPlayers: { [Player]: boolean } = {}
local cachedArenaMinX = ARENA_MIN_X
local cachedArenaMaxX = ARENA_MAX_X
local cachedArenaMinZ = ARENA_MIN_Z
local cachedArenaMaxZ = ARENA_MAX_Z

runAnimation.Name = "MonkeyBossRun"
runAnimation.AnimationId = RUN_ANIMATION_ID

local function getCharacterFromHit(hit: BasePart): Model?
	local candidate = hit:FindFirstAncestorOfClass("Model")
	if candidate and candidate:FindFirstChildOfClass("Humanoid") then
		return candidate
	end

	return nil
end

local function getPlayerFromHit(hit: BasePart): Player?
	local character = getCharacterFromHit(hit)
	if not character then
		return nil
	end

	return Players:GetPlayerFromCharacter(character)
end

local function findMechanicsAncestor(instance: Instance): Folder?
	local current = instance.Parent
	while current do
		if current.Name == MECHANICS_NAME and current:IsA("Folder") then
			return current
		end
		current = current.Parent
	end

	return nil
end

local function resolveBossZoneAndMechanics(): (Folder?, Folder?)
	local preferredZone = Workspace:FindFirstChild(ZONE_NAME)
	if preferredZone and preferredZone:IsA("Folder") then
		local preferredMechanics = preferredZone:FindFirstChild(MECHANICS_NAME)
		if preferredMechanics and preferredMechanics:IsA("Folder") then
			local preferredStartGate = preferredMechanics:FindFirstChild(START_GATE_NAME)
			local preferredFinishGate = preferredMechanics:FindFirstChild(FINISH_GATE_NAME)
			if preferredStartGate and preferredFinishGate then
				return preferredZone, preferredMechanics
			end
		end
	end

	local startGateInstance = Workspace:FindFirstChild(START_GATE_NAME, true)
	if startGateInstance then
		local foundMechanics = findMechanicsAncestor(startGateInstance)
		local foundZone = foundMechanics and foundMechanics.Parent
		if foundMechanics and foundZone and foundZone:IsA("Folder") then
			return foundZone, foundMechanics
		end
	end

	if preferredZone and preferredZone:IsA("Folder") then
		local preferredMechanics = preferredZone:FindFirstChild(MECHANICS_NAME)
		if preferredMechanics and preferredMechanics:IsA("Folder") then
			return preferredZone, preferredMechanics
		end
	end

	return nil, nil
end

local function refreshArenaBounds()
	local arenaFloor = if zone then zone:FindFirstChild(ARENA_FLOOR_NAME, true) else nil
	if arenaFloor and arenaFloor:IsA("BasePart") then
		local halfSizeX = arenaFloor.Size.X * 0.5
		local halfSizeZ = arenaFloor.Size.Z * 0.5
		cachedArenaMinX = arenaFloor.Position.X - halfSizeX
		cachedArenaMaxX = arenaFloor.Position.X + halfSizeX
		cachedArenaMinZ = arenaFloor.Position.Z - halfSizeZ
		cachedArenaMaxZ = arenaFloor.Position.Z + halfSizeZ
	end
end

local function getStageZBounds(): (number, number)
	return cachedArenaMinZ, cachedArenaMaxZ
end

local function getArenaXBounds(): (number, number)
	return cachedArenaMinX, cachedArenaMaxX
end

local function isPositionInsideArena(position: Vector3, padding: number?): boolean
	local arenaPadding = padding or ARENA_DETECTION_PADDING
	local minX, maxX = getArenaXBounds()
	local minZ, maxZ = getStageZBounds()

	return position.X >= minX - arenaPadding
		and position.X <= maxX + arenaPadding
		and position.Z >= minZ - arenaPadding
		and position.Z <= maxZ + arenaPadding
end

local function shouldChasePlayer(player: Player, position: Vector3): boolean
	local currentStage = player:GetAttribute("CurrentStage")
	if currentStage == STAGE_NUMBER then
		return activeEncounterPlayers[player] == true and isPositionInsideArena(position)
	end

	if type(currentStage) == "number" and currentStage >= COMPLETE_STAGE then
		-- Completed players can re-enter Stage 4 from Stage 5 and retrigger the chase.
		return isPositionInsideArena(position, 0)
	end

	return false
end

local function killCharacter(player: Player, character: Model)
	local now = os.clock()
	local lastKillTime = lastKillTimes[player] or 0
	if now - lastKillTime < KILL_COOLDOWN_SECONDS then
		return
	end

	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if humanoid and humanoid.Health > 0 then
		lastKillTimes[player] = now
		humanoid.Health = 0
	end
end

local function configureBoss(model: Model)
	model.Name = BOSS_NAME
	model:SetAttribute("EncounterState", "Idle")

	local humanoid = model:FindFirstChildOfClass("Humanoid")
	local root = model:FindFirstChild("HumanoidRootPart")
	if root and root:IsA("BasePart") then
		model.PrimaryPart = root
	end

	if humanoid then
		humanoid.AutoRotate = false
		humanoid.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
		humanoid.NameDisplayDistance = 0
		humanoid.WalkSpeed = 0

		if not humanoid:FindFirstChildOfClass("Animator") then
			local animator = Instance.new("Animator")
			animator.Parent = humanoid
		end
	end

	for _, descendant in model:GetDescendants() do
		if descendant:IsA("BasePart") then
			descendant.CanCollide = false
			descendant.CanTouch = false
			descendant.CanQuery = false
			descendant.Massless = true
			descendant.Anchored = descendant.Name == "HumanoidRootPart" or descendant.Name == "RootPart"

			if not descendant.Anchored then
				pcall(function()
					descendant:SetNetworkOwner(nil)
				end)
			end
		end
	end
end

local function stopRunAnimation()
	if runTrack then
		runTrack:Stop(0.18)
		runTrack = nil
		runTrackBoss = nil
	end
end

local function loadRunTrack(model: Model): AnimationTrack?
	if runTrack and runTrackBoss == model then
		return runTrack
	end

	stopRunAnimation()

	local humanoid = model:FindFirstChildOfClass("Humanoid")
	local animator = humanoid and humanoid:FindFirstChildOfClass("Animator")
	if not animator then
		return nil
	end

	local track = animator:LoadAnimation(runAnimation)
	track.Looped = true
	track.Priority = Enum.AnimationPriority.Movement
	runTrack = track
	runTrackBoss = model

	return track
end

local function warmRunAnimation(model: Model)
	local track = loadRunTrack(model)
	if not track then
		return
	end

	track:Play(0)
	track:AdjustSpeed(0)
	track:Stop(0)
	track:AdjustSpeed(1)
end

local function playRunAnimation(model: Model)
	local track = loadRunTrack(model)
	if not track then
		return
	end

	if not track.IsPlaying then
		track:Play(0.08)
	end
end

local function findBossModel(): Model?
	local currentZone = zone
	if not currentZone then
		return nil
	end

	local currentMechanics = mechanics
	if currentMechanics then
		local existingInMechanics = currentMechanics:FindFirstChild(BOSS_NAME, true)
		if existingInMechanics and existingInMechanics:IsA("Model") then
			return existingInMechanics
		end
	end

	local existingInZone = currentZone:FindFirstChild(BOSS_NAME)
	if existingInZone and existingInZone:IsA("Model") then
		return existingInZone
	end

	local existingInWorkspace = Workspace:FindFirstChild(BOSS_NAME, true)
	if existingInWorkspace and existingInWorkspace:IsA("Model") then
		existingInWorkspace.Parent = currentMechanics or currentZone
		return existingInWorkspace
	end

	if bossTemplate then
		local clone = bossTemplate:Clone()
		clone.Parent = currentMechanics or currentZone
		return clone
	end

	return nil
end

local function ensureBoss(): Model?
	local model = boss
	if model and model.Parent and model:FindFirstChild("HumanoidRootPart") then
		return model
	end

	stopRunAnimation()

	model = findBossModel()
	if not model then
		return nil
	end

	configureBoss(model)
	boss = model

	if not bossTemplate then
		bossTemplate = model:Clone()
		bossTemplate.Parent = nil
	end

	model:PivotTo(HOME_PIVOT)
	warmRunAnimation(model)
	return model
end

local function findNearestRunner(model: Model): BasePart?
	local bossPosition = model:GetPivot().Position
	local closestRoot: BasePart? = nil
	local closestDistance = math.huge
	for _, player in Players:GetPlayers() do
		local character = player.Character
		local humanoid = if character then character:FindFirstChildOfClass("Humanoid") else nil
		local root = if character then character:FindFirstChild("HumanoidRootPart") else nil

		if humanoid and humanoid.Health > 0 and root and root:IsA("BasePart") then
			local position = root.Position
			if shouldChasePlayer(player, position) then
				local distance = (position - bossPosition).Magnitude
				if distance < closestDistance then
					closestDistance = distance
					closestRoot = root
				end
			end
		end
	end

	return closestRoot
end

local function getPlayerFromCharacter(character: Model?): Player?
	if not character then
		return nil
	end

	return Players:GetPlayerFromCharacter(character)
end

local function getFlatDistance(a: Vector3, b: Vector3): number
	return (Vector3.new(a.X, 0, a.Z) - Vector3.new(b.X, 0, b.Z)).Magnitude
end

local function repairBossVisualIfNeeded(model: Model)
	local now = os.clock()
	if now - lastVisualRepairTime < VISUAL_REPAIR_INTERVAL then
		return
	end
	lastVisualRepairTime = now

	local pivot = model:GetPivot()
	local boundingBox = model:GetBoundingBox()
	if (boundingBox.Position - pivot.Position).Magnitude <= VISUAL_DRIFT_DISTANCE then
		return
	end

	local wasRunning = runTrack and runTrack.IsPlaying
	configureBoss(model)
	model:PivotTo(pivot)

	if wasRunning then
		playRunAnimation(model)
	end
end

local function advanceToward(current: CFrame, targetPosition: Vector3, speed: number, deltaTime: number): CFrame
	local currentPosition = current.Position
	local flatTarget = Vector3.new(targetPosition.X, HOME_PIVOT.Position.Y, targetPosition.Z)
	local offset = flatTarget - currentPosition
	local minStageX, maxStageX = getArenaXBounds()
	local minStageZ, maxStageZ = getStageZBounds()
	if offset.Magnitude < 0.05 then
		return current
	end

	local stepDistance = speed * deltaTime
	local nextPosition = if offset.Magnitude <= stepDistance
		then flatTarget
		else currentPosition + offset.Unit * stepDistance

	nextPosition = Vector3.new(
		math.clamp(nextPosition.X, minStageX, maxStageX),
		HOME_PIVOT.Position.Y,
		math.clamp(nextPosition.Z, minStageZ, maxStageZ)
	)

	local lookTarget = Vector3.new(flatTarget.X, nextPosition.Y, flatTarget.Z)
	local lookOffset = lookTarget - nextPosition
	if lookOffset.Magnitude > 0.05 then
		return CFrame.lookAt(nextPosition, lookTarget)
	end

	return CFrame.new(nextPosition) * (current - currentPosition)
end

local function setupPlayer(player: Player)
	player.CharacterAdded:Connect(function()
		activeEncounterPlayers[player] = nil
	end)
end

local function connectStageGates()
	local currentStartGate = startGate
	local currentFinishGate = finishGate
	local currentKillFloor = killFloor
	if not currentStartGate or not currentFinishGate then
		return
	end

	currentStartGate.Touched:Connect(function(hit: BasePart)
		local player = getPlayerFromHit(hit)
		if not player then
			return
		end

		local currentStage = player:GetAttribute("CurrentStage")
		if type(currentStage) ~= "number" or currentStage < STAGE_NUMBER then
			player:SetAttribute("CurrentStage", STAGE_NUMBER)
		end
		activeEncounterPlayers[player] = true
	end)

	currentFinishGate.Touched:Connect(function(hit: BasePart)
		local player = getPlayerFromHit(hit)
		if player then
			activeEncounterPlayers[player] = nil
			if player:GetAttribute("CurrentStage") == STAGE_NUMBER then
				player:SetAttribute("CurrentStage", COMPLETE_STAGE)
			end
		end
	end)

	if currentKillFloor then
		currentKillFloor.Touched:Connect(function(hit: BasePart)
			local character = getCharacterFromHit(hit)
			local player = getPlayerFromCharacter(character)
			local root = if character then character:FindFirstChild("HumanoidRootPart") else nil
			if player and character and root and root:IsA("BasePart") and shouldChasePlayer(player, root.Position) then
				killCharacter(player, character)
			end
		end)
	end
end

function BossChaseService.Init()
	runAnimation.Parent = script
	script:SetAttribute("Initialized", false)
	script:SetAttribute("Started", false)
	script:SetAttribute("StartBlocked", "")

	local foundZone, foundMechanics = resolveBossZoneAndMechanics()
	if not foundZone then
		script:SetAttribute("StartBlocked", "Boss zone with Stage4Start not found")
		warn("[BossChaseService] Boss zone with Stage4Start not found")
		return
	end

	zone = foundZone
	script:SetAttribute("ZonePath", foundZone:GetFullName())
	refreshArenaBounds()

	local legacyController = foundZone:FindFirstChild(LEGACY_CONTROLLER_NAME)
	if legacyController and legacyController:IsA("BaseScript") then
		legacyController.Disabled = true
	end

	if not foundMechanics then
		script:SetAttribute("StartBlocked", "Mechanics folder with Stage4Start not found")
		warn("[BossChaseService] Mechanics folder with Stage4Start not found")
		return
	end

	mechanics = foundMechanics
	script:SetAttribute("MechanicsPath", foundMechanics:GetFullName())

	local foundStartGate = foundMechanics:FindFirstChild(START_GATE_NAME)
	local foundFinishGate = foundMechanics:FindFirstChild(FINISH_GATE_NAME)
	local foundKillFloor = foundMechanics:FindFirstChild(KILL_FLOOR_NAME)

	if foundStartGate and foundStartGate:IsA("BasePart") then
		startGate = foundStartGate
	end
	if foundFinishGate and foundFinishGate:IsA("BasePart") then
		finishGate = foundFinishGate
	end
	if foundKillFloor and foundKillFloor:IsA("BasePart") then
		killFloor = foundKillFloor
	end

	connectStageGates()
	script:SetAttribute("Initialized", true)
end

function BossChaseService.Start()
	if not zone or not mechanics or not startGate or not finishGate then
		script:SetAttribute("StartBlocked", "Missing zone, mechanics, startGate, or finishGate")
		return
	end

	local model = ensureBoss()
	if not model then
		script:SetAttribute("StartBlocked", "MonkeyBoss model not found")
		warn("[BossChaseService] MonkeyBoss model not found")
		return
	end

	task.spawn(function()
		pcall(function()
			ContentProvider:PreloadAsync({ runAnimation })
		end)
		warmRunAnimation(model)
	end)

	for _, player in Players:GetPlayers() do
		setupPlayer(player)
	end
	Players.PlayerAdded:Connect(setupPlayer)
	Players.PlayerRemoving:Connect(function(player: Player)
		activeEncounterPlayers[player] = nil
		lastKillTimes[player] = nil
	end)

	script:SetAttribute("Started", true)
	script:SetAttribute("HeartbeatTicks", 0)
	RunService.Heartbeat:Connect(function(deltaTime: number)
		heartbeatTicks += 1
		local activeBoss = ensureBoss()
		if not activeBoss then
			script:SetAttribute("LastRunner", "NoBoss")
			return
		end
		repairBossVisualIfNeeded(activeBoss)

		local runnerRoot = findNearestRunner(activeBoss)
		if runnerRoot then
			local now = os.clock()
			if now - lastDebugAttributeTime >= DEBUG_ATTRIBUTE_INTERVAL then
				lastDebugAttributeTime = now
				script:SetAttribute("HeartbeatTicks", heartbeatTicks)
				script:SetAttribute("LastRunner", runnerRoot:GetFullName())
			end
			activeBoss:SetAttribute("EncounterState", "Chasing")
			playRunAnimation(activeBoss)
			activeBoss:PivotTo(advanceToward(activeBoss:GetPivot(), runnerRoot.Position, CHASE_SPEED, deltaTime))

			if getFlatDistance(runnerRoot.Position, activeBoss:GetPivot().Position) <= TOUCH_KILL_DISTANCE then
				local character = runnerRoot.Parent
				local player = getPlayerFromCharacter(if character and character:IsA("Model") then character else nil)
				if player and character and character:IsA("Model") then
					killCharacter(player, character)
				end
			end
		else
			local now = os.clock()
			if now - lastDebugAttributeTime >= DEBUG_ATTRIBUTE_INTERVAL then
				lastDebugAttributeTime = now
				script:SetAttribute("HeartbeatTicks", heartbeatTicks)
				script:SetAttribute("LastRunner", "")
			end
			local current = activeBoss:GetPivot()
			local distanceHome = (HOME_PIVOT.Position - current.Position).Magnitude
			if distanceHome > 0.05 then
				activeBoss:SetAttribute("EncounterState", "Returning")
				playRunAnimation(activeBoss)
				activeBoss:PivotTo(advanceToward(current, HOME_PIVOT.Position, RETURN_SPEED, deltaTime))
			else
				activeBoss:SetAttribute("EncounterState", "Idle")
				activeBoss:PivotTo(HOME_PIVOT)
				stopRunAnimation()
			end
		end
	end)
end

return BossChaseService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="129">
          <Properties>
            <string name="Name">DataService</string>
            <string name="Source"><![CDATA[--!strict -- Bật chế độ kiểm tra kiểu dữ liệu của Luau.

-- game:GetService() là cách tốt nhất và an toàn nhất để lấy các dịch vụ hệ thống của Roblox.
local Players = game:GetService("Players") -- Quản lý tất cả người chơi trong game.
local RunService = game:GetService("RunService") -- Giúp kiểm tra xem game đang chạy trên Studio hay server thật.
local ServerScriptService = game:GetService("ServerScriptService") -- Thư mục chứa các script bảo mật chạy trên server.

-- Nạp cấu hình Constants dùng chung và thư viện ProfileStore để lưu trữ dữ liệu an toàn.
local Constants = require(game.ReplicatedStorage.Shared.Constants)
local ProfileStore = require(ServerScriptService.ServerPackages.ProfileStore)

-- Định nghĩa kiểu dữ liệu (Luau Types) cho dễ lập trình và tránh nhầm lẫn biến.
type PlayerData = typeof(Constants.DATA_TEMPLATE)
type Profile = any

-- Tên cơ sở dữ liệu trên máy chủ Roblox. Nếu đổi tên này, toàn bộ người chơi sẽ chơi lại từ đầu (Reset Data).
local DATA_STORE_NAME = "SpeedEscape_Player_v1"
local STUDIO_TEST_TOTAL_WINS = 1000000
local STUDIO_TEST_SPEED = 150
local STUDIO_TEST_LEVEL = 73

-- Tạo một cửa hàng dữ liệu (Store) dựa trên cấu trúc DATA_TEMPLATE mặc định.
local playerStore = ProfileStore.New(DATA_STORE_NAME, Constants.DATA_TEMPLATE)

-- HỌC TẬP: Nếu đang chạy test trong Roblox Studio (RunService:IsStudio() == true),
-- chúng ta sẽ chuyển sang chế độ "Mock" (chạy trên bộ nhớ tạm RAM).
-- Điều này giúp kiểm thử dữ liệu nhanh hơn, không tốn tài nguyên mạng và không sợ làm hỏng dữ liệu thật của người chơi.
if RunService:IsStudio() then
	playerStore = playerStore.Mock
end

-- Bảng lưu trữ phiên dữ liệu đang hoạt động của mỗi người chơi.
local profiles: { [Player]: Profile } = {}
-- Bảng lưu trữ thư mục leaderstats để cập nhật điểm nhanh chóng.
local leaderstatsByPlayer: { [Player]: Folder } = {}

local DataService = {}

-- Hàm phụ trợ: Tạo nhanh một đối tượng Value (ví dụ IntValue, NumberValue) để hiển thị điểm lên bảng.
local function createValue(parent: Instance, className: string, name: string, value: any): Instance
	local instance = Instance.new(className)
	instance.Name = name
	local valueObject = instance :: any
	valueObject.Value = value
	instance.Parent = parent
	return instance
end

-- HỌC TẬP: Tạo thư mục "leaderstats" bên trong đối tượng Player.
-- Roblox có cơ chế mặc định: Bất kỳ thư mục nào tên đúng là "leaderstats" (chữ thường) 
-- chứa các đối tượng Value bên trong sẽ tự động được vẽ thành bảng xếp hạng ở góc trên bên phải màn hình game!
local function createLeaderstats(player: Player)
	local leaderstats = Instance.new("Folder")
	leaderstats.Name = "leaderstats"
	leaderstats.Parent = player

	-- Tạo 4 cột điểm hiển thị trên bảng: Speed, Wins, Level và Rebirths.
	createValue(leaderstats, "NumberValue", "Speed", 0)
	createValue(leaderstats, "NumberValue", "Wins", 0)
	createValue(leaderstats, "IntValue", "Level", 1)
	createValue(leaderstats, "IntValue", "Rebirths", 0)

	leaderstatsByPlayer[player] = leaderstats
end

local function readNumber(data: { [string]: any }, key: string, fallback: number): number
	local value = data[key]
	if typeof(value) == "number" and value == value then
		return value
	end

	data[key] = fallback
	return fallback
end

local function normalizeData(data: { [string]: any })
	readNumber(data, "Speed", 0)
	readNumber(data, "TotalWins", 0)
	readNumber(data, "CurrentRunWins", 0)
	readNumber(data, "Streak", 0)
	readNumber(data, "PersonalBestDistance", 0)
	readNumber(data, "PersonalBestRunWins", 0)
	readNumber(data, "TotalRuns", 0)
	readNumber(data, "TotalDonatedRobux", 0)
	readNumber(data, "HighestCompletedStage", 0)
	readNumber(data, "Rebirths", 0)
	readNumber(data, "Level", 1)
	readNumber(data, "XP", 0)
	readNumber(data, "CustomSpeedLimit", Constants.DEFAULT_WALK_SPEED)

	if typeof(data.EquippedTreadmill) ~= "string" then
		data.EquippedTreadmill = "treadmill_1"
	end
	if typeof(data.EquippedTrail) ~= "string" then
		data.EquippedTrail = "none"
	end
	if typeof(data.EquippedAura) ~= "string" then
		data.EquippedAura = "none"
	end
	if typeof(data.UnlockedTreadmills) ~= "table" then
		data.UnlockedTreadmills = { treadmill_1 = true }
	end
	if typeof(data.UnlockedTrails) ~= "table" then
		data.UnlockedTrails = { none = true }
	end
	if typeof(data.UnlockedAuras) ~= "table" then
		data.UnlockedAuras = { none = true }
	end

	if RunService:IsStudio() then
		data.TotalWins = math.max(data.TotalWins, STUDIO_TEST_TOTAL_WINS)
		data.Speed = STUDIO_TEST_SPEED
		data.Level = STUDIO_TEST_LEVEL
		data.CustomSpeedLimit = Constants.GetMaxWalkSpeed(STUDIO_TEST_LEVEL)
	end
end

local function updateLeaderstats(player: Player, data: PlayerData)
	local leaderstats = leaderstatsByPlayer[player]
	if not leaderstats then
		return
	end

	local speed = leaderstats:FindFirstChild("Speed") :: NumberValue?
	local wins = leaderstats:FindFirstChild("Wins") :: NumberValue?
	local level = leaderstats:FindFirstChild("Level") :: IntValue?
	local rebirths = leaderstats:FindFirstChild("Rebirths") :: IntValue?

	if speed then
		speed.Value = math.floor(data.Speed)
	end
	if wins then
		wins.Value = math.floor(data.TotalWins)
	end
	if level then
		level.Value = math.floor(data.Level)
	end
	if rebirths then
		rebirths.Value = math.floor(data.Rebirths)
	end
end

local function loadPlayer(player: Player)
	createLeaderstats(player)

	local profile = playerStore:StartSessionAsync(`Player_{player.UserId}`, {
		Cancel = function()
			return player.Parent ~= Players
		end,
	})

	if not profile then
		player:Kick("Could not load your data. Please rejoin.")
		return
	end

	profile:AddUserId(player.UserId)
	profile:Reconcile()
	normalizeData(profile.Data)

	profile.OnSessionEnd:Connect(function()
		profiles[player] = nil
		player:Kick("Your data session ended. Please rejoin.")
	end)

	if player.Parent ~= Players then
		profile:EndSession()
		return
	end

	profiles[player] = profile
	updateLeaderstats(player, profile.Data)
	player:SetAttribute("ProfileLoaded", true)
	player:SetAttribute("HighestCompletedStage", math.floor(readNumber(profile.Data, "HighestCompletedStage", 0)))
end

function DataService.Init() end

function DataService.Start()
	for _, player in Players:GetPlayers() do
		task.spawn(loadPlayer, player)
	end

	Players.PlayerAdded:Connect(function(player)
		task.spawn(loadPlayer, player)
	end)

	Players.PlayerRemoving:Connect(function(player)
		player:SetAttribute("ProfileLoaded", false)
		leaderstatsByPlayer[player] = nil

		local profile = profiles[player]
		if profile then
			profiles[player] = nil
			profile:EndSession()
		end
	end)
end

function DataService.GetData(player: Player): PlayerData?
	local profile = profiles[player]
	if not profile or not profile:IsActive() then
		return nil
	end

	return profile.Data
end

function DataService.IsLoaded(player: Player): boolean
	return DataService.GetData(player) ~= nil
end

function DataService.UpdateLeaderstats(player: Player)
	local data = DataService.GetData(player)
	if data then
		updateLeaderstats(player, data)
	end
end

return DataService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="130">
          <Properties>
            <string name="Name">LeaderboardService</string>
            <string name="Source"><![CDATA[--!strict
local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local DataService = require(script.Parent.DataService)

type BoardConfig = {
	modelName: string,
	title: string,
	valueSuffix: string,
	storeName: string,
	dataKey: string,
	accent: Color3,
	darkAccent: Color3,
}

type RankedEntry = {
	userId: number,
	name: string,
	value: number,
	avatar: string,
}

local TOP_LIMIT = 50
local ROWS_PER_PAGE = 8
local REFRESH_SECONDS = 60
local PAGE_SECONDS = 7
local MAX_ORDERED_VALUE = 9e15
local STUDS_TEXTURE = "rbxassetid://6372755229"
local DEFAULT_AVATAR = "rbxasset://textures/ui/GuiImagePlaceholder.png"

local BOARD_CONFIGS: { BoardConfig } = {
	{
		modelName = "Top_Speeds",
		title = "TOP SPEED",
		valueSuffix = " SPEED",
		storeName = "SpeedEscape_TopSpeed_v1",
		dataKey = "Speed",
		accent = Color3.fromRGB(46, 204, 113),
		darkAccent = Color3.fromRGB(0, 117, 79),
	},
	{
		modelName = "Top_Wins",
		title = "TOP WINS",
		valueSuffix = " WINS",
		storeName = "SpeedEscape_TopWins_v1",
		dataKey = "TotalWins",
		accent = Color3.fromRGB(255, 190, 34),
		darkAccent = Color3.fromRGB(180, 86, 0),
	},
	{
		modelName = "Top_Donate",
		title = "TOP DONATE",
		valueSuffix = " R$",
		storeName = "SpeedEscape_TopDonate_v1",
		dataKey = "TotalDonatedRobux",
		accent = Color3.fromRGB(52, 152, 219),
		darkAccent = Color3.fromRGB(0, 82, 160),
	},
}

local stores: { [string]: OrderedDataStore } = {}
local boardRoots: { [string]: Frame } = {}
local entriesByBoard: { [string]: { RankedEntry } } = {}
local avatarCache: { [number]: string } = {}
local nameCache: { [number]: string } = {}
local lastPublishedValues: { [string]: { [number]: number } } = {}

local LeaderboardService = {}

local function create(className: string, properties: { [string]: any }?, parent: Instance?): Instance
	local instance = Instance.new(className)
	if properties then
		for key, value in properties do
			(instance :: any)[key] = value
		end
	end
	instance.Parent = parent
	return instance
end

local function addCorner(parent: Instance, radius: number)
	create("UICorner", { CornerRadius = UDim.new(0, radius) }, parent)
end

local function addStroke(parent: Instance, color: Color3, thickness: number)
	create("UIStroke", {
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		Color = color,
		Thickness = thickness,
	}, parent)
end

local function addStuds(parent: Instance, transparency: number, zIndex: number)
	create("ImageLabel", {
		BackgroundTransparency = 1,
		Image = STUDS_TEXTURE,
		ImageTransparency = transparency,
		Position = UDim2.fromScale(0, 0),
		ScaleType = Enum.ScaleType.Tile,
		Size = UDim2.fromScale(1, 1),
		TileSize = UDim2.fromOffset(30, 30),
		ZIndex = zIndex,
	}, parent)
end

local function formatNumber(value: number): string
	if value >= 1e12 then
		return string.format("%.2fT", value / 1e12)
	elseif value >= 1e9 then
		return string.format("%.2fB", value / 1e9)
	elseif value >= 1e6 then
		return string.format("%.2fM", value / 1e6)
	elseif value >= 1e3 then
		return string.format("%.2fK", value / 1e3)
	end
	return tostring(math.floor(value))
end

local function getDisplayName(userId: number): string
	local cached = nameCache[userId]
	if cached then
		return cached
	end

	local success, result = pcall(Players.GetNameFromUserIdAsync, Players, userId)
	local name = if success then result else `Player {userId}`
	nameCache[userId] = name
	return name
end

local function getAvatar(userId: number): string
	local cached = avatarCache[userId]
	if cached then
		return cached
	end

	local success, image = pcall(
		Players.GetUserThumbnailAsync,
		Players,
		userId,
		Enum.ThumbnailType.HeadShot,
		Enum.ThumbnailSize.Size150x150
	)
	local avatar = if success then image else DEFAULT_AVATAR
	avatarCache[userId] = avatar
	return avatar
end

local function getBoardRoot(config: BoardConfig): Frame?
	local folder = Workspace:FindFirstChild("LeaderBoard")
	local model = folder and folder:FindFirstChild(config.modelName)
	local panel = model and model:FindFirstChild("DisplayPanel")
	local surfaceGui = panel and panel:FindFirstChildWhichIsA("SurfaceGui")
	local root = surfaceGui and surfaceGui:FindFirstChild("Frame")
	if not root or not root:IsA("Frame") then
		warn(`[LeaderboardService] Missing {config.modelName}.DisplayPanel.SurfaceGui.Frame`)
		return nil
	end

	root:ClearAllChildren()
	root.BackgroundColor3 = Color3.fromRGB(9, 22, 42)
	root.BorderSizePixel = 0
	root.ZIndex = 0

	local header = create("Frame", {
		BackgroundColor3 = config.accent,
		BorderSizePixel = 0,
		Position = UDim2.fromOffset(16, 14),
		Size = UDim2.new(1, -32, 0, 126),
		ZIndex = 1,
	}, root)
	addCorner(header, 22)
	addStroke(header, config.darkAccent, 5)
	addStuds(header, 0.72, 2)

	create("TextLabel", {
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamBlack,
		Position = UDim2.fromOffset(12, 10),
		Size = UDim2.new(1, -24, 0, 70),
		Text = config.title,
		TextColor3 = Color3.fromRGB(255, 255, 255),
		TextScaled = true,
		TextStrokeColor3 = Color3.fromRGB(0, 0, 0),
		TextStrokeTransparency = 0,
		ZIndex = 3,
	}, header)

	create("TextLabel", {
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamBold,
		Position = UDim2.fromOffset(12, 82),
		Size = UDim2.new(1, -24, 0, 30),
		Text = "GLOBAL TOP 50",
		TextColor3 = Color3.fromRGB(255, 245, 171),
		TextScaled = true,
		TextStrokeTransparency = 0.2,
		ZIndex = 3,
	}, header)

	create("Frame", {
		BackgroundTransparency = 1,
		Name = "RankList",
		Position = UDim2.fromOffset(18, 160),
		Size = UDim2.new(1, -36, 0, 746),
		ZIndex = 1,
	}, root)

	create("TextLabel", {
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamBold,
		Name = "PageLabel",
		Position = UDim2.new(0, 18, 1, -72),
		Size = UDim2.new(1, -36, 0, 52),
		Text = "PAGE 1 / 1",
		TextColor3 = Color3.fromRGB(167, 205, 255),
		TextScaled = true,
		TextStrokeTransparency = 0.35,
		ZIndex = 2,
	}, root)

	return root :: Frame
end

local function createRankRow(parent: Instance, config: BoardConfig, entry: RankedEntry, rank: number, row: number)
	local isTopThree = rank <= 3
	local rowColor = if isTopThree then config.darkAccent:Lerp(config.accent, 0.38) else Color3.fromRGB(20, 47, 78)
	local rankColor = if rank == 1
		then Color3.fromRGB(255, 220, 64)
		elseif rank == 2
		then Color3.fromRGB(230, 238, 255)
		elseif rank == 3
		then Color3.fromRGB(255, 167, 89)
		else Color3.fromRGB(173, 209, 255)

	local container = create("Frame", {
		BackgroundColor3 = rowColor,
		BorderSizePixel = 0,
		Position = UDim2.fromOffset(0, (row - 1) * 91),
		Size = UDim2.new(1, 0, 0, 82),
		ZIndex = 2,
	}, parent)
	addCorner(container, 14)
	addStroke(container, if isTopThree then rankColor else Color3.fromRGB(45, 100, 148), 3)

	create("TextLabel", {
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamBlack,
		Position = UDim2.fromOffset(10, 15),
		Size = UDim2.fromOffset(84, 52),
		Text = `#{rank}`,
		TextColor3 = rankColor,
		TextScaled = true,
		TextStrokeColor3 = Color3.fromRGB(0, 0, 0),
		TextStrokeTransparency = 0,
		ZIndex = 3,
	}, container)

	local avatar = create("ImageLabel", {
		BackgroundColor3 = Color3.fromRGB(236, 245, 255),
		Image = entry.avatar,
		Position = UDim2.fromOffset(102, 8),
		Size = UDim2.fromOffset(66, 66),
		ZIndex = 3,
	}, container)
	addCorner(avatar, 33)
	addStroke(avatar, Color3.fromRGB(255, 255, 255), 3)

	create("TextLabel", {
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamBold,
		Position = UDim2.fromOffset(184, 12),
		Size = UDim2.new(0.42, 0, 0, 58),
		Text = entry.name,
		TextColor3 = Color3.fromRGB(255, 255, 255),
		TextScaled = true,
		TextStrokeTransparency = 0.35,
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 3,
	}, container)

	create("TextLabel", {
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamBlack,
		Position = UDim2.new(0.62, 0, 0, 14),
		Size = UDim2.new(0.36, -8, 0, 54),
		Text = formatNumber(entry.value) .. config.valueSuffix,
		TextColor3 = Color3.fromRGB(255, 244, 169),
		TextScaled = true,
		TextStrokeColor3 = Color3.fromRGB(0, 0, 0),
		TextStrokeTransparency = 0.1,
		TextXAlignment = Enum.TextXAlignment.Right,
		ZIndex = 3,
	}, container)
end

local function renderPage(config: BoardConfig, page: number)
	local root = boardRoots[config.modelName]
	if not root then
		return
	end

	local list = root:FindFirstChild("RankList") :: Frame?
	local pageLabel = root:FindFirstChild("PageLabel") :: TextLabel?
	if not list or not pageLabel then
		return
	end

	list:ClearAllChildren()
	local entries = entriesByBoard[config.modelName] or {}
	local pageCount = math.max(1, math.ceil(#entries / ROWS_PER_PAGE))
	local currentPage = ((page - 1) % pageCount) + 1
	pageLabel.Text = `PAGE {currentPage} / {pageCount}`

	if #entries == 0 then
		create("TextLabel", {
			BackgroundTransparency = 1,
			Font = Enum.Font.GothamBold,
			Position = UDim2.fromOffset(24, 190),
			Size = UDim2.new(1, -48, 0, 100),
			Text = "NO RANKED PLAYERS YET",
			TextColor3 = Color3.fromRGB(167, 205, 255),
			TextScaled = true,
			ZIndex = 2,
		}, list)
		return
	end

	local firstIndex = ((currentPage - 1) * ROWS_PER_PAGE) + 1
	for row = 1, ROWS_PER_PAGE do
		local index = firstIndex + row - 1
		local entry = entries[index]
		if entry then
			createRankRow(list, config, entry, index, row)
		end
	end
end

local function getOnlineFallback(config: BoardConfig): { RankedEntry }
	local entries = {}
	for _, player in Players:GetPlayers() do
		local data = DataService.GetData(player)
		local value = data and data[config.dataKey]
		if typeof(value) == "number" then
			table.insert(entries, {
				userId = player.UserId,
				name = player.Name,
				value = value,
				avatar = getAvatar(player.UserId),
			})
		end
	end
	table.sort(entries, function(a, b)
		return a.value > b.value
	end)
	return entries
end

local function refreshEntries(config: BoardConfig)
	local store = stores[config.modelName]
	local success, pages = pcall(store.GetSortedAsync, store, false, TOP_LIMIT)
	if not success then
		entriesByBoard[config.modelName] = getOnlineFallback(config)
		return
	end

	local entries = {}
	for _, orderedEntry in pages:GetCurrentPage() do
		local userId = tonumber(orderedEntry.key)
		if userId then
			table.insert(entries, {
				userId = userId,
				name = getDisplayName(userId),
				value = orderedEntry.value,
				avatar = getAvatar(userId),
			})
		end
	end
	entriesByBoard[config.modelName] = entries
end

local function publishPlayer(player: Player)
	local data = DataService.GetData(player)
	if not data then
		return
	end

	for _, config in BOARD_CONFIGS do
		local value = data[config.dataKey]
		if typeof(value) == "number" then
			local safeValue = math.clamp(math.floor(value), 0, MAX_ORDERED_VALUE)
			local published = lastPublishedValues[config.modelName]
			if published[player.UserId] ~= safeValue then
				published[player.UserId] = safeValue
				task.spawn(function()
					local success, err = pcall(
						stores[config.modelName].SetAsync,
						stores[config.modelName],
						tostring(player.UserId),
						safeValue
					)
					if not success and not RunService:IsStudio() then
						warn(`[LeaderboardService] Failed to publish {config.modelName}: {err}`)
					end
				end)
			end
		end
	end
end

function LeaderboardService.Init()
	for _, config in BOARD_CONFIGS do
		stores[config.modelName] = DataStoreService:GetOrderedDataStore(config.storeName)
		lastPublishedValues[config.modelName] = {}
		local root = getBoardRoot(config)
		if root then
			boardRoots[config.modelName] = root
			entriesByBoard[config.modelName] = {}
			renderPage(config, 1)
		end
	end
end

function LeaderboardService.Start()
	task.spawn(function()
		task.wait(2)
		local page = 1
		local nextRefresh = 0
		while true do
			if os.clock() >= nextRefresh then
				for _, player in Players:GetPlayers() do
					publishPlayer(player)
				end
				for _, config in BOARD_CONFIGS do
					refreshEntries(config)
				end
				nextRefresh = os.clock() + REFRESH_SECONDS
			end

			for _, config in BOARD_CONFIGS do
				renderPage(config, page)
			end
			page += 1
			task.wait(PAGE_SECONDS)
		end
	end)

	Players.PlayerRemoving:Connect(function(player)
		publishPlayer(player)
	end)
end

function LeaderboardService.RecordDonation(player: Player, robuxAmount: number): boolean
	local data = DataService.GetData(player)
	if not data or robuxAmount <= 0 or robuxAmount ~= robuxAmount or math.abs(robuxAmount) == math.huge then
		return false
	end

	data.TotalDonatedRobux += math.floor(robuxAmount)
	publishPlayer(player)
	return true
end

return LeaderboardService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="131">
          <Properties>
            <string name="Name">ProgressionService</string>
            <string name="Source"><![CDATA[--!strict
local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Constants = require(ReplicatedStorage.Shared.Constants)
local GamePackets = require(ReplicatedStorage.Shared.Network.GamePackets)

local DataService = require(script.Parent.DataService)

type PlayerData = typeof(Constants.DATA_TEMPLATE)

type TreadmillZone = {
	id: string,
	multiplier: number,
	cframe: CFrame,
	size: Vector3,
}

type PlayerSession = {
	lastPosition: Vector3?,
	lastRequestTime: { [string]: number },
	gamepassMultiplier: number?,
	activeTreadmillId: string,
	activeTreadmillMultiplier: number,
	isOnTreadmill: boolean,
	appliedTrailId: string?,
}

local treadmillZones: { TreadmillZone } = {}
local sessions: { [Player]: PlayerSession } = {}

local ProgressionService = {}
local STUDIO_TEST_SPEED_CAP = 150

local function getSession(player: Player): PlayerSession
	local session = sessions[player]
	if session then
		return session
	end

	session = {
		lastPosition = nil,
		lastRequestTime = {},
		gamepassMultiplier = nil,
		activeTreadmillId = "treadmill_1",
		activeTreadmillMultiplier = 1,
		isOnTreadmill = false,
		appliedTrailId = nil,
	}
	sessions[player] = session
	return session
end

local TRAIL_OBJECT_NAME = "SpeedEscapeEquippedTrail"
local TRAIL_ATTACHMENT_A_NAME = "SpeedEscapeTrailAttachmentA"
local TRAIL_ATTACHMENT_B_NAME = "SpeedEscapeTrailAttachmentB"

local TRAIL_VISUALS = {
	trail_green = {
		color = ColorSequence.new(Color3.fromRGB(79, 255, 111), Color3.fromRGB(13, 171, 65)),
		lifetime = 0.5,
		texture = "",
		textureLength = 1,
		widthScale = 1,
		lightEmission = 0.75,
	},
	trail_blue = {
		color = ColorSequence.new(Color3.fromRGB(89, 207, 255), Color3.fromRGB(43, 91, 255)),
		lifetime = 0.55,
		texture = "",
		textureLength = 1,
		widthScale = 1,
		lightEmission = 0.75,
	},
	trail_purple = {
		color = ColorSequence.new(Color3.fromRGB(207, 112, 255), Color3.fromRGB(98, 45, 255)),
		lifetime = 0.6,
		texture = "",
		textureLength = 1,
		widthScale = 1,
		lightEmission = 0.78,
	},
	trail_red = {
		color = ColorSequence.new(Color3.fromRGB(255, 95, 76), Color3.fromRGB(210, 24, 40)),
		lifetime = 0.6,
		texture = "",
		textureLength = 1,
		widthScale = 1,
		lightEmission = 0.78,
	},
	trail_rainbow = {
		color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 52, 52)),
			ColorSequenceKeypoint.new(0.2, Color3.fromRGB(255, 176, 43)),
			ColorSequenceKeypoint.new(0.4, Color3.fromRGB(255, 245, 65)),
			ColorSequenceKeypoint.new(0.6, Color3.fromRGB(58, 235, 82)),
			ColorSequenceKeypoint.new(0.8, Color3.fromRGB(65, 163, 255)),
			ColorSequenceKeypoint.new(1, Color3.fromRGB(188, 81, 255)),
		}),
		lifetime = 0.72,
		texture = "",
		textureLength = 1,
		widthScale = 1.15,
		lightEmission = 0.9,
	},
	trail_galaxy = {
		color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, Color3.fromRGB(12, 0, 128)),
			ColorSequenceKeypoint.new(0.18, Color3.fromRGB(42, 36, 255)),
			ColorSequenceKeypoint.new(0.46, Color3.fromRGB(186, 28, 255)),
			ColorSequenceKeypoint.new(0.72, Color3.fromRGB(255, 38, 194)),
			ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 245, 92)),
		}),
		lifetime = 1.35,
		texture = "rbxasset://textures/particles/sparkles_main.dds",
		textureLength = 0.38,
		widthScale = 2.05,
		lightEmission = 1,
	},
}

local function isRateLimited(player: Player, key: string): boolean
	local session = getSession(player)
	local now = os.clock()
	local lastRequestTime = session.lastRequestTime[key] or 0
	if now - lastRequestTime < Constants.NETWORK_RATE_LIMIT_SECONDS then
		return true
	end

	session.lastRequestTime[key] = now
	return false
end

local function getCharacterParts(player: Player): (Humanoid?, BasePart?)
	local character = player.Character
	if not character then
		return nil, nil
	end

	local humanoid = character:FindFirstChildOfClass("Humanoid")
	local root = character:FindFirstChild("HumanoidRootPart")
	if not humanoid or not root or not root:IsA("BasePart") then
		return nil, nil
	end

	return humanoid, root
end

local function clearTrailVisual(character: Model)
	for _, descendant in character:GetDescendants() do
		if
			descendant.Name == TRAIL_OBJECT_NAME
			or descendant.Name == TRAIL_ATTACHMENT_A_NAME
			or descendant.Name == TRAIL_ATTACHMENT_B_NAME
		then
			descendant:Destroy()
		end
	end
end

local function applyTrailVisual(player: Player, data: PlayerData)
	local session = getSession(player)
	local character = player.Character
	local _, root = getCharacterParts(player)
	if not character or not root then
		return
	end

	local trailId = data.EquippedTrail
	if session.appliedTrailId == trailId and root:FindFirstChild(TRAIL_OBJECT_NAME) then
		return
	end

	clearTrailVisual(character)
	session.appliedTrailId = trailId

	if trailId == "none" then
		return
	end

	local visual = TRAIL_VISUALS[trailId]
	if not visual then
		session.appliedTrailId = "none"
		return
	end

	local attachmentA = Instance.new("Attachment")
	attachmentA.Name = TRAIL_ATTACHMENT_A_NAME
	attachmentA.Position = Vector3.new(0, 1.6, 0.18)
	attachmentA.Parent = root

	local attachmentB = Instance.new("Attachment")
	attachmentB.Name = TRAIL_ATTACHMENT_B_NAME
	attachmentB.Position = Vector3.new(0, -1.7, 0.18)
	attachmentB.Parent = root

	local trail = Instance.new("Trail")
	trail.Name = TRAIL_OBJECT_NAME
	trail.Attachment0 = attachmentA
	trail.Attachment1 = attachmentB
	trail.Color = visual.color
	trail.FaceCamera = true
	trail.Lifetime = visual.lifetime
	trail.LightEmission = visual.lightEmission
	trail.LightInfluence = 0
	trail.MinLength = 0.08
	trail.Texture = visual.texture
	trail.TextureLength = visual.textureLength
	trail.TextureMode = Enum.TextureMode.Wrap
	trail.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, if trailId == "trail_galaxy" then 0 else 0.08),
		NumberSequenceKeypoint.new(0.72, if trailId == "trail_galaxy" then 0.02 else 0.22),
		NumberSequenceKeypoint.new(1, if trailId == "trail_galaxy" then 0.35 else 1),
	})
	trail.WidthScale = NumberSequence.new({
		NumberSequenceKeypoint.new(0, visual.widthScale),
		NumberSequenceKeypoint.new(0.65, visual.widthScale * 0.72),
		NumberSequenceKeypoint.new(1, 0),
	})
	trail.Parent = root
end

local function computeGamepassMultiplier(player: Player): number
	local session = getSession(player)
	if session.gamepassMultiplier then
		return session.gamepassMultiplier
	end

	local multiplier = 1
	local passMultipliers = {
		{ id = Constants.GAMEPASS_IDS.DoubleSpeed, multiplier = 2 },
		{ id = Constants.GAMEPASS_IDS.QuadSpeed, multiplier = 4 },
		{ id = Constants.GAMEPASS_IDS.OctaSpeed, multiplier = 8 },
	}

	for _, pass in passMultipliers do
		if pass.id > 0 then
			local success, ownsPass = pcall(function()
				return MarketplaceService:UserOwnsGamePassAsync(player.UserId, pass.id)
			end)
			if success and ownsPass then
				multiplier *= pass.multiplier
			end
		end
	end

	session.gamepassMultiplier = multiplier
	return multiplier
end

local function getEffectiveMaxWalkSpeed(data: PlayerData): number
	return math.max(Constants.DEFAULT_WALK_SPEED, Constants.GetMaxWalkSpeed(data.Level))
end

local function applyWalkSpeed(player: Player, data: PlayerData)
	local humanoid = getCharacterParts(player)
	if not humanoid then
		return
	end

	local maxWalkSpeed = getEffectiveMaxWalkSpeed(data)
	local customSpeed = math.clamp(data.CustomSpeedLimit, Constants.DEFAULT_WALK_SPEED, maxWalkSpeed)
	data.CustomSpeedLimit = customSpeed
	humanoid.WalkSpeed = customSpeed
end

local function getTreadmillAtPosition(position: Vector3): (string, number, boolean)
	for _, zone in treadmillZones do
		local localPosition = zone.cframe:PointToObjectSpace(position)
		local halfSize = zone.size * 0.5
		if
			math.abs(localPosition.X) <= halfSize.X + 2
			and math.abs(localPosition.Z) <= halfSize.Z + 2
			and math.abs(localPosition.Y) <= halfSize.Y + Constants.TREADMILL_GAIN_RADIUS
		then
			return zone.id, zone.multiplier, true
		end
	end

	return "treadmill_1", 1, false
end

local function getGainMultiplier(player: Player, data: PlayerData): number
	local session = getSession(player)
	local configuredTreadmill = Constants.GetTreadmillById(data.EquippedTreadmill)
	local treadmillMultiplier = if configuredTreadmill then configuredTreadmill.multiplier else 1

	if session.activeTreadmillMultiplier > treadmillMultiplier then
		treadmillMultiplier = session.activeTreadmillMultiplier
	end

	return treadmillMultiplier
		* Constants.GetTrailMultiplier(data.EquippedTrail)
		* Constants.GetAuraMultiplier(data.EquippedAura)
		* Constants.GetRebirthMultiplier(data.Rebirths)
		* computeGamepassMultiplier(player)
end

local function getCosmeticConfig(category: string, itemId: string): any?
	local catalog = if category == "trail" then Constants.TRAILS elseif category == "aura" then Constants.AURAS else nil
	if not catalog then
		return nil
	end

	for _, config in catalog do
		if config.id == itemId then
			return config
		end
	end

	return nil
end

local function buildSnapshot(player: Player, data: PlayerData)
	local session = getSession(player)
	local maxWalkSpeed = getEffectiveMaxWalkSpeed(data)
	local requiredRebirthLevel = Constants.GetRequiredLevelForRebirth(data.Rebirths)
	local requiredXP = Constants.GetRequiredXP(data.Level)

	return {
		isLoaded = true,
		speed = data.Speed,
		totalWins = data.TotalWins,
		currentRunWins = data.CurrentRunWins,
		streak = math.clamp(math.floor(data.Streak), 0, 65535),
		personalBestDistance = data.PersonalBestDistance,
		personalBestRunWins = data.PersonalBestRunWins,
		totalRuns = math.clamp(math.floor(data.TotalRuns), 0, 4294967295),
		highestCompletedStage = math.clamp(math.floor((data :: any).HighestCompletedStage or 0), 0, 65535),
		level = math.clamp(math.floor(data.Level), 0, 65535),
		xp = data.XP,
		requiredXP = requiredXP,
		rebirths = math.clamp(math.floor(data.Rebirths), 0, 65535),
		maxWalkSpeed = maxWalkSpeed,
		customSpeedLimit = data.CustomSpeedLimit,
		gainMultiplier = getGainMultiplier(player, data),
		treadmillMultiplier = session.activeTreadmillMultiplier,
		isOnTreadmill = session.isOnTreadmill,
		canRebirth = data.Level >= requiredRebirthLevel,
		requiredRebirthLevel = math.clamp(requiredRebirthLevel, 0, 65535),
		activeTreadmillId = session.activeTreadmillId,
		equippedTrail = data.EquippedTrail,
		equippedAura = data.EquippedAura,
		unlockedTrails = data.UnlockedTrails,
		unlockedAuras = data.UnlockedAuras,
	}
end

local function sendSnapshot(player: Player)
	local data = DataService.GetData(player)
	if not data then
		GamePackets.profileSnapshot.sendTo({
			isLoaded = false,
			speed = 0,
			totalWins = 0,
			currentRunWins = 0,
			streak = 0,
			personalBestDistance = 0,
			personalBestRunWins = 0,
			totalRuns = 0,
			highestCompletedStage = 0,
			level = 1,
			xp = 0,
			requiredXP = Constants.GetRequiredXP(1),
			rebirths = 0,
			maxWalkSpeed = Constants.DEFAULT_WALK_SPEED,
			customSpeedLimit = Constants.DEFAULT_WALK_SPEED,
			gainMultiplier = 1,
			treadmillMultiplier = 1,
			isOnTreadmill = false,
			canRebirth = false,
			requiredRebirthLevel = Constants.GetRequiredLevelForRebirth(0),
			activeTreadmillId = "treadmill_1",
			equippedTrail = "none",
			equippedAura = "none",
			unlockedTrails = { none = true },
			unlockedAuras = { none = true },
		}, player)
		return
	end

	GamePackets.profileSnapshot.sendTo(buildSnapshot(player, data), player)
end

local function addSpeed(player: Player, data: PlayerData, amount: number)
	if amount <= 0 then
		return
	end

	local previousMaxWalkSpeed = getEffectiveMaxWalkSpeed(data)
	local wasUsingMaxWalkSpeed = data.CustomSpeedLimit >= previousMaxWalkSpeed

	local appliedAmount = amount
	if RunService:IsStudio() then
		appliedAmount = math.max(0, math.min(amount, STUDIO_TEST_SPEED_CAP - data.Speed))
	end
	if appliedAmount <= 0 then
		applyWalkSpeed(player, data)
		DataService.UpdateLeaderstats(player)
		sendSnapshot(player)
		return
	end

	data.Speed += appliedAmount
	data.XP += appliedAmount * Constants.XP_CONVERSION_RATE

	while data.XP >= Constants.GetRequiredXP(data.Level) do
		data.XP -= Constants.GetRequiredXP(data.Level)
		data.Level += 1
	end

	if wasUsingMaxWalkSpeed then
		data.CustomSpeedLimit = getEffectiveMaxWalkSpeed(data)
	end

	applyWalkSpeed(player, data)
	DataService.UpdateLeaderstats(player)
	sendSnapshot(player)
end

-- HỌC TẬP: Vòng lặp chính xử lý tiến trình Speed của từng người chơi.
-- Vòng lặp này chạy độc lập cho mỗi Player bằng task.spawn.
local function runProgressionLoop(player: Player)
	local session = getSession(player)

	-- Điều kiện lặp: Trong khi Player vẫn nằm trong dịch vụ Players (tức là họ chưa thoát game).
	-- Đây là cách viết cực kỳ quan trọng để Tránh Rò Rỉ Bộ Nhớ (Memory Leak). Nếu player thoát, vòng lặp tự động dừng!
	while player.Parent == Players do
		local data = DataService.GetData(player)
		local humanoid, root = getCharacterParts(player)

		-- Chỉ cộng Speed nếu dữ liệu đã tải xong, nhân vật tồn tại và nhân vật còn sống (Health > 0).
		if data and humanoid and root and humanoid.Health > 0 then
			applyTrailVisual(player, data)

			-- 1. Kiểm tra xem người chơi có đang đứng trên Máy chạy bộ nào không
			local treadmillId, treadmillMultiplier, isOnTreadmill = getTreadmillAtPosition(root.Position)
			session.activeTreadmillId = treadmillId
			session.activeTreadmillMultiplier = treadmillMultiplier
			session.isOnTreadmill = isOnTreadmill

			-- 2. Đo đạc khoảng cách di chuyển của người chơi giữa 2 lần kiểm tra (Vector Math)
			local lastPosition = session.lastPosition
			session.lastPosition = root.Position

			-- Tính độ dài khoảng cách di chuyển (Magnitude) của vector hiệu (Vị trí mới - Vị trí cũ)
			local movedDistance = if lastPosition then (root.Position - lastPosition).Magnitude else 0
			
			-- 3. Kiểm tra xem người chơi có đang di chuyển thật sự không:
			-- humanoid.MoveDirection.Magnitude > 0.05: Người chơi đang bấm WASD hoặc cần gạt Analog điện thoại.
			-- movedDistance >= Constants.MIN_MOVEMENT_FOR_SPEED_GAIN: Người chơi có sự di chuyển thực tế (phòng trường hợp bị trượt hoặc lực đẩy vật lý).
			-- isOnTreadmill: Hoặc người chơi đang đứng trên máy chạy bộ (kể cả đứng im cũng được tính điểm).
			local isActivelyMoving = humanoid.MoveDirection.Magnitude > 0.05
				or movedDistance >= Constants.MIN_MOVEMENT_FOR_SPEED_GAIN
				or isOnTreadmill

			-- 4. Nếu đang di chuyển, tiến hành cộng Speed dựa trên hệ số nhân!
			if isActivelyMoving then
				local amount = Constants.BASE_SPEED_GAIN * getGainMultiplier(player, data)
				addSpeed(player, data, amount)
			else
				-- Nếu đứng im trên đất thường, chúng ta chỉ cập nhật lại WalkSpeed của họ (đảm bảo đồng bộ).
				applyWalkSpeed(player, data)
			end
		end

		-- Dừng vòng lặp một chút (ở đây là 0.35 giây) trước khi lặp lại.
		-- Không được bỏ task.wait() vì nếu không có nó, vòng lặp sẽ chạy hàng triệu lần mỗi giây làm treo (Crash) Server ngay lập tức!
		task.wait(Constants.SPEED_GAIN_INTERVAL)
	end
end

local function cacheTreadmillZones()
	table.clear(treadmillZones)

	local multiplierToId = {
		[1] = "treadmill_1",
		[3] = "treadmill_2",
		[9] = "treadmill_3",
		[25] = "treadmill_4",
		[100] = "treadmill_5",
	}

	for _, instance in Workspace:GetChildren() do
		local multiplierText = instance.Name:match("^Treadmill_x(%d+)$")
		if instance:IsA("Model") and multiplierText then
			local multiplier = tonumber(multiplierText)
			local treadmillId = multiplier and multiplierToId[multiplier]
			if treadmillId and multiplier then
				local cframe, size = instance:GetBoundingBox()
				table.insert(treadmillZones, {
					id = treadmillId,
					multiplier = multiplier,
					cframe = cframe,
					size = size,
				})
			end
		end
	end
end

function ProgressionService.Init()
	cacheTreadmillZones()
end

function ProgressionService.Start()
	GamePackets.requestSnapshot.listen(function(_data, player: Player)
		if isRateLimited(player, "snapshot") then
			return
		end
		sendSnapshot(player)
	end)

	GamePackets.requestCustomSpeed.listen(function(data, player: Player)
		if isRateLimited(player, "customSpeed") then
			return
		end

		local profileData = DataService.GetData(player)
		if
			not profileData
			or typeof(data.walkSpeed) ~= "number"
			or data.walkSpeed ~= data.walkSpeed
			or math.abs(data.walkSpeed) == math.huge
		then
			return
		end

		local maxWalkSpeed = getEffectiveMaxWalkSpeed(profileData)
		profileData.CustomSpeedLimit = math.clamp(
			math.floor(data.walkSpeed),
			Constants.DEFAULT_WALK_SPEED,
			maxWalkSpeed
		)
		applyWalkSpeed(player, profileData)
		sendSnapshot(player)
	end)

	GamePackets.requestRebirth.listen(function(_data, player: Player)
		if isRateLimited(player, "rebirth") then
			return
		end

		local data = DataService.GetData(player)
		if not data then
			return
		end

		local requiredLevel = Constants.GetRequiredLevelForRebirth(data.Rebirths)
		if data.Level < requiredLevel then
			return
		end

		data.Speed = 0
		data.Level = 1
		data.XP = 0
		data.Rebirths += 1
		data.CustomSpeedLimit = Constants.DEFAULT_WALK_SPEED

		applyWalkSpeed(player, data)
		DataService.UpdateLeaderstats(player)
		GamePackets.toast.sendTo({
			kind = "rebirth",
			message = "Rebirth complete",
			amount = data.Rebirths,
		}, player)
		sendSnapshot(player)
	end)

	GamePackets.requestCosmeticAction.listen(function(request, player: Player)
		if isRateLimited(player, "cosmeticAction") then
			return
		end

		local data = DataService.GetData(player)
		if not data or typeof(request.category) ~= "string" or typeof(request.itemId) ~= "string" then
			return
		end

		local config = getCosmeticConfig(request.category, request.itemId)
		if not config then
			return
		end

		local unlockedItems = if request.category == "trail" then data.UnlockedTrails else data.UnlockedAuras
		local wasUnlocked = unlockedItems[request.itemId] == true
		if not unlockedItems[request.itemId] then
			if data.TotalWins < config.priceWins then
				GamePackets.toast.sendTo({
					kind = "cosmetic",
					message = "Not enough Wins",
					amount = 0,
				}, player)
				return
			end

			data.TotalWins -= config.priceWins
			unlockedItems[request.itemId] = true
		end

		if request.category == "trail" then
			data.EquippedTrail = if data.EquippedTrail == request.itemId then "none" else request.itemId
			applyTrailVisual(player, data)
		else
			data.EquippedAura = if data.EquippedAura == request.itemId then "none" else request.itemId
		end

		DataService.UpdateLeaderstats(player)
		GamePackets.toast.sendTo({
			kind = "cosmetic",
			message = if wasUnlocked then "Equipped" else "Purchased",
			amount = 0,
		}, player)
		sendSnapshot(player)
	end)

	local function watchCharacter(player: Player)
		player.CharacterAdded:Connect(function()
			local session = getSession(player)
			session.appliedTrailId = nil
			task.delay(0.25, function()
				local data = DataService.GetData(player)
				if data then
					applyTrailVisual(player, data)
				end
			end)
		end)
	end

	for _, player in Players:GetPlayers() do
		watchCharacter(player)
		task.spawn(runProgressionLoop, player)
	end

	Players.PlayerAdded:Connect(function(player)
		watchCharacter(player)
		task.spawn(runProgressionLoop, player)
	end)

	Players.PlayerRemoving:Connect(function(player)
		sessions[player] = nil
	end)
end

function ProgressionService.AwardWins(player: Player, amount: number, reason: string?)
	local data = DataService.GetData(player)
	if not data or amount <= 0 then
		return false
	end

	data.TotalWins += amount
	data.CurrentRunWins += amount
	data.PersonalBestRunWins = math.max(data.PersonalBestRunWins, data.CurrentRunWins)
	DataService.UpdateLeaderstats(player)
	GamePackets.toast.sendTo({
		kind = reason or "wins",
		message = "Wins earned",
		amount = amount,
	}, player)
	sendSnapshot(player)
	return true
end

function ProgressionService.SendSnapshot(player: Player)
	sendSnapshot(player)
end

return ProgressionService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="132">
          <Properties>
            <string name="Name">RaceService</string>
            <string name="Source"><![CDATA[--!strict

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Constants = require(ReplicatedStorage.Shared.Constants)
local ProgressionService = require(script.Parent.ProgressionService)

local FINISH_PAD_DISTANCE = 40

local finishCooldowns: { [Player]: number } = {}
local zone5Event: RemoteEvent

local RaceService = {}

local function getCharacterRoot(player: Player): BasePart?
	local character = player.Character
	if not character then
		return nil
	end

	local humanoid = character:FindFirstChildOfClass("Humanoid")
	local root = character:FindFirstChild("HumanoidRootPart")
	if not humanoid or humanoid.Health <= 0 or not root or not root:IsA("BasePart") then
		return nil
	end

	return root
end

local function getPlayerFromHit(hit: BasePart): Player?
	local character = hit:FindFirstAncestorOfClass("Model")
	if not character then
		return nil
	end

	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not humanoid or humanoid.Health <= 0 then
		return nil
	end

	return Players:GetPlayerFromCharacter(character)
end

local function connectTouched(part: BasePart, callback: (BasePart, BasePart) -> ())
	part.Touched:Connect(function(hit: BasePart)
		if hit:IsA("BasePart") then
			callback(part, hit)
		end
	end)
end

local function onFinishTouched(finishPart: BasePart, hit: BasePart)
	local player = getPlayerFromHit(hit)
	if not player then
		return
	end

	local now = os.clock()
	if now - (finishCooldowns[player] or 0) < Constants.FINISH_REWARD_COOLDOWN then
		return
	end

	local root = getCharacterRoot(player)
	if not root or (root.Position - finishPart.Position).Magnitude > FINISH_PAD_DISTANCE then
		return
	end

	finishCooldowns[player] = now
	local awarded = ProgressionService.AwardWins(player, Constants.FINISH_REWARD_WINS, "finish")
	if awarded then
		zone5Event:FireClient(player, "Victory", finishPart.Position)
	end
end

function RaceService.Init()
	local existingEvent = ReplicatedStorage:FindFirstChild("Zone5Event")
	if existingEvent and existingEvent:IsA("RemoteEvent") then
		zone5Event = existingEvent
	else
		zone5Event = Instance.new("RemoteEvent")
		zone5Event.Name = "Zone5Event"
		zone5Event.Parent = ReplicatedStorage
	end
end

function RaceService.Start()
	-- Stage finish checkpoints and rewards are handled by StageCheckpointService.

	Players.PlayerRemoving:Connect(function(player: Player)
		finishCooldowns[player] = nil
	end)
end

return RaceService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="133">
          <Properties>
            <string name="Name">ReceiptService</string>
            <string name="Source"><![CDATA[--!strict
local MarketplaceService = game:GetService("MarketplaceService")

local StageCheckpointService = require(script.Parent.StageCheckpointService)
local TeleportService = require(script.Parent.TeleportService)

local ReceiptService = {}

local receiptProcessors = {
	TeleportService.ProcessReceipt,
	StageCheckpointService.ProcessReceipt,
}

local function processReceipt(receiptInfo: { [string]: any }): Enum.ProductPurchaseDecision
	for _, processor in receiptProcessors do
		local decision = processor(receiptInfo)
		if decision == Enum.ProductPurchaseDecision.PurchaseGranted then
			return decision
		end
	end

	return Enum.ProductPurchaseDecision.NotProcessedYet
end

function ReceiptService.Init()
	MarketplaceService.ProcessReceipt = processReceipt
end

function ReceiptService.Start() end

return ReceiptService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="134">
          <Properties>
            <string name="Name">Stage5DropMachineService</string>
            <string name="Source"><![CDATA[--!strict
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Stage5DropMachineService = {}

local ZONE_NAME = "Zone5"
local MECHANICS_NAME = "Mechanics"
local DROP_MACHINE_NAME = "DropMachine"
local SPAWNER_NAME = "SpawnerCenter"
local STAGE_START_NAME = "Stage5Start"
local LEGACY_SPAWN_SCRIPT_NAME = "SpawnLogic"
local LEGACY_ZONE_CONTROLLER_NAME = "Zone5Controller"
local OBSTACLE_NAME = "DropMachineObstacle"
local STAGE_NUMBER = 5

local SPAWN_INTERVAL_SECONDS = 1.35
local OBSTACLE_SIZE = Vector3.new(10, 10, 10)
local OBSTACLE_SPEED = 42
local OBSTACLE_LIFETIME_SECONDS = 30
local CLEANUP_CHECK_INTERVAL_SECONDS = 0.25
local KILL_COOLDOWN_SECONDS = 0.65
local FALL_CLEANUP_OFFSET_Y = 16
local STAGE_START_CLEANUP_PADDING = 1
local FALL_RESET_Y = 5
local VOID_CHECK_INTERVAL_SECONDS = 0.1
local STAGE5_FALLBACK_MIN_Z = 1746
local STAGE5_FALLBACK_MAX_Z = 2395
local START_TRANSITION_ZONE_NAME = "Zone4"
local START_TRANSITION_NAME = "Transition4To5"
local FINISH_TRANSITION_ZONE_NAME = "Zone5"
local FINISH_TRANSITION_NAME = "Transition5To6"

local random = Random.new()
local mechanics: Folder?
local spawner: BasePart?
local stageStart: BasePart?
local activeObstacles: { BasePart } = {}
local lastKillTimes: { [Player]: number } = {}
local obstacleTouchConnections: { [BasePart]: RBXScriptConnection } = {}

local BODY_PART_NAMES = {
	HumanoidRootPart = true,
	Head = true,
	Torso = true,
	UpperTorso = true,
	LowerTorso = true,
	LeftArm = true,
	RightArm = true,
	LeftLeg = true,
	RightLeg = true,
	LeftUpperArm = true,
	LeftLowerArm = true,
	LeftHand = true,
	RightUpperArm = true,
	RightLowerArm = true,
	RightHand = true,
	LeftUpperLeg = true,
	LeftLowerLeg = true,
	LeftFoot = true,
	RightUpperLeg = true,
	RightLowerLeg = true,
	RightFoot = true,
}

local SHAPES = {
	{ shape = Enum.PartType.Ball, color = Color3.fromRGB(255, 34, 34) },
	{ shape = Enum.PartType.Block, color = Color3.fromRGB(34, 102, 255) },
	{ shape = Enum.PartType.Cylinder, color = Color3.fromRGB(31, 255, 95) },
}

local function isCharacterBodyPart(part: BasePart): (Player?, Humanoid?)
	if not BODY_PART_NAMES[part.Name] then
		return nil, nil
	end

	local character = part.Parent
	if not character or not character:IsA("Model") then
		return nil, nil
	end

	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not humanoid or humanoid.Health <= 0 then
		return nil, nil
	end

	local player = Players:GetPlayerFromCharacter(character)
	if not player then
		return nil, nil
	end

	return player, humanoid
end

local function killPlayer(player: Player, humanoid: Humanoid)
	local now = os.clock()
	if now - (lastKillTimes[player] or 0) < KILL_COOLDOWN_SECONDS then
		return
	end

	lastKillTimes[player] = now
	humanoid.Health = 0
end

local function getTransitionPart(zoneName: string, transitionName: string): BasePart?
	local transitionZone = Workspace:FindFirstChild(zoneName)
	local ground = transitionZone and transitionZone:FindFirstChild("Ground")
	local transition = ground and ground:FindFirstChild(transitionName)
	if transition and transition:IsA("BasePart") then
		return transition
	end

	return nil
end

local function getStage5ZBounds(): (number, number)
	local startTransition = getTransitionPart(START_TRANSITION_ZONE_NAME, START_TRANSITION_NAME)
	local finishTransition = getTransitionPart(FINISH_TRANSITION_ZONE_NAME, FINISH_TRANSITION_NAME)
	if startTransition and finishTransition then
		return math.min(startTransition.Position.Z, finishTransition.Position.Z),
			math.max(startTransition.Position.Z, finishTransition.Position.Z)
	end

	return STAGE5_FALLBACK_MIN_Z, STAGE5_FALLBACK_MAX_Z
end

local function shouldWatchStage5Void(player: Player): boolean
	local activeStage = player:GetAttribute("ActiveStage")
	if activeStage == STAGE_NUMBER then
		return true
	end

	return player:GetAttribute("CurrentStage") == STAGE_NUMBER
end

local function processStage5VoidFalls()
	local minStageZ, maxStageZ = getStage5ZBounds()
	for _, player in Players:GetPlayers() do
		if shouldWatchStage5Void(player) then
			local character = player.Character
			local root = character and character:FindFirstChild("HumanoidRootPart")
			local humanoid = character and character:FindFirstChildOfClass("Humanoid")
			if root and root:IsA("BasePart") and humanoid and humanoid.Health > 0 then
				local position = root.Position
				if position.Y < FALL_RESET_Y and position.Z >= minStageZ and position.Z <= maxStageZ then
					killPlayer(player, humanoid)
				end
			end
		end
	end
end

local function getCharactersForOverlap(): { Instance }
	local characters = {}
	for _, player in Players:GetPlayers() do
		local character = player.Character
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		if character and humanoid and humanoid.Health > 0 then
			table.insert(characters, character)
		end
	end

	return characters
end

local function disableLegacyDropMachineScript(dropMachine: Model)
	local foundSpawner = dropMachine:FindFirstChild(SPAWNER_NAME)
	local legacyScript = foundSpawner and foundSpawner:FindFirstChild(LEGACY_SPAWN_SCRIPT_NAME)
	if legacyScript and legacyScript:IsA("BaseScript") then
		legacyScript.Disabled = true
	end
end

local function disableLegacyZoneController(zone: Instance)
	local legacyScript = zone:FindFirstChild(LEGACY_ZONE_CONTROLLER_NAME)
	if legacyScript and legacyScript:IsA("BaseScript") then
		legacyScript.Disabled = true
		legacyScript.Name = "Zone5Controller_DISABLED_OLD"
	end
end

local function unregisterObstacle(obstacle: BasePart)
	local connection = obstacleTouchConnections[obstacle]
	if connection then
		connection:Disconnect()
		obstacleTouchConnections[obstacle] = nil
	end
end

local function destroyObstacle(obstacle: BasePart)
	unregisterObstacle(obstacle)
	if obstacle.Parent then
		obstacle:Destroy()
	end
end

local function connectObstacleTouch(obstacle: BasePart)
	obstacleTouchConnections[obstacle] = obstacle.Touched:Connect(function(hit: BasePart)
		if not hit:IsA("BasePart") then
			return
		end

		local player, humanoid = isCharacterBodyPart(hit)
		if player and humanoid then
			killPlayer(player, humanoid)
		end
	end)
end

local function hasObstacleReachedStageStart(obstacle: BasePart): boolean
	local currentStageStart = stageStart
	local currentSpawner = spawner
	if not currentStageStart or not currentSpawner then
		return false
	end

	local travelVector = currentStageStart.Position - currentSpawner.Position
	if travelVector.Magnitude < 0.01 then
		local halfExtent = math.max(obstacle.Size.X, obstacle.Size.Y, obstacle.Size.Z) * 0.5
		return obstacle.Position.Z - halfExtent <= currentStageStart.Position.Z + STAGE_START_CLEANUP_PADDING
	end

	local travelDirection = travelVector.Unit
	local halfExtent = math.max(obstacle.Size.X, obstacle.Size.Y, obstacle.Size.Z) * 0.5
	local distanceFromStart = (obstacle.Position - currentStageStart.Position):Dot(travelDirection)
	return distanceFromStart >= -halfExtent - STAGE_START_CLEANUP_PADDING
end

local function removeExistingObstacles(parent: Instance)
	for _, child in parent:GetChildren() do
		if child:IsA("BasePart") and (child.Name == OBSTACLE_NAME or child.Name == "NeonObstacle") then
			child:Destroy()
		end
	end
end

local function spawnObstacle()
	local currentSpawner = spawner
	local currentMechanics = mechanics
	if not currentSpawner or not currentMechanics then
		return
	end

	local shapeInfo = SHAPES[random:NextInteger(1, #SHAPES)]
	local part = Instance.new("Part")
	part.Name = OBSTACLE_NAME
	part.Shape = shapeInfo.shape
	part.Size = OBSTACLE_SIZE
	part.Color = shapeInfo.color
	part.Material = Enum.Material.Neon
	part.CanCollide = true
	part.CanTouch = true
	part.CanQuery = true
	part.Anchored = false
	part.CustomPhysicalProperties = PhysicalProperties.new(10, 0, 0, 1, 1)
	part:SetAttribute("ManagedByStage5DropMachineService", true)

	local randomX = random:NextNumber(-30, 30)
	local spawnCFrame = currentSpawner.CFrame * CFrame.new(randomX, 0, 0)
	if shapeInfo.shape == Enum.PartType.Cylinder then
		spawnCFrame *= CFrame.Angles(0, 0, math.pi / 2)
	end
	part.CFrame = spawnCFrame
	part.AssemblyLinearVelocity = currentSpawner.CFrame.LookVector * OBSTACLE_SPEED
	part.Parent = currentMechanics
	connectObstacleTouch(part)

	table.insert(activeObstacles, part)

	task.delay(OBSTACLE_LIFETIME_SECONDS, function()
		destroyObstacle(part)
	end)
end

local function cleanupObstacles()
	local currentStageStart = stageStart
	for index = #activeObstacles, 1, -1 do
		local obstacle = activeObstacles[index]
		if not obstacle.Parent then
			unregisterObstacle(obstacle)
			table.remove(activeObstacles, index)
		elseif currentStageStart then
			local passedStart = hasObstacleReachedStageStart(obstacle)
			local fellBelowStage = obstacle.Position.Y < currentStageStart.Position.Y - FALL_CLEANUP_OFFSET_Y
			if passedStart or fellBelowStage then
				destroyObstacle(obstacle)
				table.remove(activeObstacles, index)
			end
		end
	end
end

local function processObstacleHits()
	if #activeObstacles == 0 then
		return
	end

	local characters = getCharactersForOverlap()
	if #characters == 0 then
		return
	end

	local params = OverlapParams.new()
	params.FilterType = Enum.RaycastFilterType.Include
	params.FilterDescendantsInstances = characters
	params.RespectCanCollide = false

	for _, obstacle in activeObstacles do
		if obstacle.Parent then
			for _, overlap in Workspace:GetPartsInPart(obstacle, params) do
				local player, humanoid = isCharacterBodyPart(overlap)
				if player and humanoid then
					killPlayer(player, humanoid)
				end
			end
		end
	end
end

function Stage5DropMachineService.Init()
	script:SetAttribute("Started", false)
	script:SetAttribute("ActiveObstacleCount", 0)
end

function Stage5DropMachineService.Start()
	local zone = Workspace:WaitForChild(ZONE_NAME, 30)
	if not zone then
		warn("[Stage5DropMachineService] Workspace.Zone5 not found")
		return
	end
	disableLegacyZoneController(zone)

	local foundMechanics = zone:WaitForChild(MECHANICS_NAME, 30)
	if not foundMechanics or not foundMechanics:IsA("Folder") then
		warn("[Stage5DropMachineService] Workspace.Zone5.Mechanics not found")
		return
	end
	mechanics = foundMechanics

	local dropMachine = foundMechanics:WaitForChild(DROP_MACHINE_NAME, 30)
	if not dropMachine or not dropMachine:IsA("Model") then
		warn("[Stage5DropMachineService] DropMachine model not found")
		return
	end
	disableLegacyDropMachineScript(dropMachine)
	removeExistingObstacles(foundMechanics)

	local foundSpawner = dropMachine:FindFirstChild(SPAWNER_NAME)
	if not foundSpawner or not foundSpawner:IsA("BasePart") then
		warn("[Stage5DropMachineService] DropMachine.SpawnerCenter not found")
		return
	end
	spawner = foundSpawner

	local foundStageStart = foundMechanics:FindFirstChild(STAGE_START_NAME)
	if foundStageStart and foundStageStart:IsA("BasePart") then
		stageStart = foundStageStart
	end

	Players.PlayerRemoving:Connect(function(player: Player)
		lastKillTimes[player] = nil
	end)

	task.spawn(function()
		while script.Parent do
			spawnObstacle()
			task.wait(SPAWN_INTERVAL_SECONDS)
		end
	end)

	task.spawn(function()
		while script.Parent do
			cleanupObstacles()
			script:SetAttribute("ActiveObstacleCount", #activeObstacles)
			task.wait(CLEANUP_CHECK_INTERVAL_SECONDS)
		end
	end)

	task.spawn(function()
		while script.Parent do
			processStage5VoidFalls()
			task.wait(VOID_CHECK_INTERVAL_SECONDS)
		end
	end)

	RunService.Heartbeat:Connect(processObstacleHits)

	script:SetAttribute("Started", true)
end

return Stage5DropMachineService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="135">
          <Properties>
            <string name="Name">Stage8SweeperService</string>
            <string name="Source"><![CDATA[--!strict
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Stage8SweeperService = {}

local ZONE_NAME = "Zone8"
local GROUND_NAME = "Ground"
local MECHANICS_NAME = "Mechanics"
local STAGE_START_NAME = "Stage8Start"
local ARENA_FLOOR_NAME = "ArenaFloor"
local SWEEPER_ARM_NAME = "SweeperArm"
local HINGE_NAME = "SpinnerHinge"
local ARROWS_FOLDER_NAME = "RotationArrows"

local STAGE_NUMBER = 8
local MIN_LEVEL_TO_SURVIVE = 74
local MIN_WALK_SPEED_TO_SURVIVE = 152
local SWEEPER_DEGREES_PER_SECOND = 45
local HIT_CHECK_INTERVAL_SECONDS = 0.05
local KILL_COOLDOWN_SECONDS = 0.75
local ARENA_RADIUS = 78
local ARROW_COUNT = 8

local arenaFloor: BasePart?
local stageStart: BasePart?
local sweeperArm: BasePart?
local spinnerHinge: HingeConstraint?
local sweepCenter: Vector3?
local baseArmCFrame: CFrame?
local sweepAngle = 0
local lastHitCheckTime = 0
local lastKillTimes: { [Player]: number } = {}

local BODY_PART_NAMES = {
	HumanoidRootPart = true,
	Head = true,
	Torso = true,
	UpperTorso = true,
	LowerTorso = true,
	LeftArm = true,
	RightArm = true,
	LeftLeg = true,
	RightLeg = true,
	LeftUpperArm = true,
	LeftLowerArm = true,
	LeftHand = true,
	RightUpperArm = true,
	RightLowerArm = true,
	RightHand = true,
	LeftUpperLeg = true,
	LeftLowerLeg = true,
	LeftFoot = true,
	RightUpperLeg = true,
	RightLowerLeg = true,
	RightFoot = true,
}

local function getPlayerFromBodyPart(part: BasePart): (Player?, Humanoid?)
	if not BODY_PART_NAMES[part.Name] then
		return nil, nil
	end

	local character = part:FindFirstAncestorOfClass("Model")
	if not character then
		return nil, nil
	end

	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not humanoid or humanoid.Health <= 0 then
		return nil, nil
	end

	local player = Players:GetPlayerFromCharacter(character)
	if not player then
		return nil, nil
	end

	return player, humanoid
end

local function getLevel(player: Player): number
	local leaderstats = player:FindFirstChild("leaderstats")
	local levelValue = leaderstats and leaderstats:FindFirstChild("Level")
	if levelValue and levelValue:IsA("IntValue") then
		return levelValue.Value
	end
	if levelValue and levelValue:IsA("NumberValue") then
		return levelValue.Value
	end

	return 1
end

local function isQualified(player: Player, humanoid: Humanoid): boolean
	return getLevel(player) >= MIN_LEVEL_TO_SURVIVE and humanoid.WalkSpeed >= MIN_WALK_SPEED_TO_SURVIVE
end

local function isPlayerInStage8(player: Player): boolean
	return player:GetAttribute("ActiveStage") == STAGE_NUMBER or player:GetAttribute("CurrentStage") == STAGE_NUMBER
end

local function isInsideArena(player: Player): boolean
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	local center = sweepCenter
	if not root or not root:IsA("BasePart") or not center then
		return false
	end

	local flatOffset = Vector3.new(root.Position.X - center.X, 0, root.Position.Z - center.Z)
	return flatOffset.Magnitude <= ARENA_RADIUS
end

local function killPlayer(player: Player, humanoid: Humanoid)
	local now = os.clock()
	if now - (lastKillTimes[player] or 0) < KILL_COOLDOWN_SECONDS then
		return
	end

	lastKillTimes[player] = now
	humanoid.Health = 0
end

local function markStage8Started(hit: BasePart)
	local player = getPlayerFromBodyPart(hit)
	if player then
		player:SetAttribute("ActiveStage", STAGE_NUMBER)
		player:SetAttribute("CurrentStage", STAGE_NUMBER)
	end
end

local function configureHinge()
	local hinge = spinnerHinge
	if not hinge then
		return
	end

	hinge.Enabled = false
	hinge.ActuatorType = Enum.ActuatorType.Motor
	hinge.AngularVelocity = math.rad(SWEEPER_DEGREES_PER_SECOND)
	hinge.MotorMaxAcceleration = 500000
	hinge.MotorMaxTorque = 1000000000
end

local function configureParts()
	local floor = arenaFloor
	local arm = sweeperArm
	if floor then
		floor.Size = Vector3.new(150, 2, 150)
		floor.Material = Enum.Material.Plastic
		floor.Color = Color3.fromRGB(75, 151, 75)
		floor.CanCollide = true
		floor.CanTouch = true
		floor.CanQuery = true
	end
	if arm then
		arm.Anchored = true
		arm.Size = Vector3.new(140, 18, 1.5)
		arm.Material = Enum.Material.Neon
		arm.Color = Color3.fromRGB(255, 67, 67)
		arm.CanCollide = true
		arm.CanTouch = true
		arm.CanQuery = true
	end
end

local function createArrowPart(parent: Instance, name: string, size: Vector3, cframe: CFrame): BasePart
	local part = parent:FindFirstChild(name)
	if not part or not part:IsA("BasePart") then
		part = Instance.new("Part")
		part.Name = name
		part.Parent = parent
	end

	part.Anchored = true
	part.CanCollide = false
	part.CanTouch = false
	part.CanQuery = false
	part.Material = Enum.Material.Neon
	part.Color = Color3.fromRGB(255, 255, 255)
	part.Transparency = 0.08
	part.Size = size
	part.CFrame = cframe
	return part
end

local function ensureRotationArrows(mechanics: Folder)
	local floor = arenaFloor
	local center = sweepCenter
	if not floor or not center then
		return
	end

	local folder = mechanics:FindFirstChild(ARROWS_FOLDER_NAME)
	if not folder or not folder:IsA("Folder") then
		folder = Instance.new("Folder")
		folder.Name = ARROWS_FOLDER_NAME
		folder.Parent = mechanics
	end

	local y = floor.Position.Y + (floor.Size.Y * 0.5) + 0.08
	for index = 1, ARROW_COUNT do
		local theta = ((index - 1) / ARROW_COUNT) * math.pi * 2
		local radial = Vector3.new(math.cos(theta), 0, math.sin(theta))
		local tangent = Vector3.new(radial.Z, 0, -radial.X)
		local position = Vector3.new(center.X, y, center.Z) + (radial * 48)
		local baseCFrame = CFrame.lookAt(position, position + tangent, Vector3.yAxis)

		createArrowPart(folder, `Arrow{index}_Shaft`, Vector3.new(2.2, 0.16, 13), baseCFrame)
		createArrowPart(folder, `Arrow{index}_HeadLeft`, Vector3.new(2.2, 0.16, 7), baseCFrame * CFrame.new(-2.2, 0, -5.2) * CFrame.Angles(0, math.rad(35), 0))
		createArrowPart(folder, `Arrow{index}_HeadRight`, Vector3.new(2.2, 0.16, 7), baseCFrame * CFrame.new(2.2, 0, -5.2) * CFrame.Angles(0, math.rad(-35), 0))
	end
end

local function updateSweeper(dt: number)
	local arm = sweeperArm
	local center = sweepCenter
	local baseCFrame = baseArmCFrame
	if not arm or not center or not baseCFrame then
		return
	end

	sweepAngle = (sweepAngle - math.rad(SWEEPER_DEGREES_PER_SECOND) * dt) % (math.pi * 2)
	arm.CFrame = CFrame.new(center) * CFrame.Angles(0, sweepAngle, 0) * (baseCFrame - baseCFrame.Position)
end

local function getCharactersForOverlap(): { Instance }
	local characters = {}
	for _, player in Players:GetPlayers() do
		local character = player.Character
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		if character and humanoid and humanoid.Health > 0 and isPlayerInStage8(player) and isInsideArena(player) then
			table.insert(characters, character)
		end
	end

	return characters
end

local function processSweeperHits()
	local arm = sweeperArm
	if not arm then
		return
	end

	local characters = getCharactersForOverlap()
	if #characters == 0 then
		return
	end

	local params = OverlapParams.new()
	params.FilterType = Enum.RaycastFilterType.Include
	params.FilterDescendantsInstances = characters
	params.RespectCanCollide = false

	for _, overlap in Workspace:GetPartsInPart(arm, params) do
		local player, humanoid = getPlayerFromBodyPart(overlap)
		if player and humanoid then
			killPlayer(player, humanoid)
		end
	end
end

function Stage8SweeperService.Init()
	script:SetAttribute("Started", false)
	script:SetAttribute("SweeperDegreesPerSecond", SWEEPER_DEGREES_PER_SECOND)
end

function Stage8SweeperService.Start()
	local zone = Workspace:WaitForChild(ZONE_NAME, 30)
	if not zone then
		warn("[Stage8SweeperService] Workspace.Zone8 not found")
		return
	end

	local foundGround = zone:WaitForChild(GROUND_NAME, 30)
	local foundMechanics = zone:WaitForChild(MECHANICS_NAME, 30)
	if not foundGround or not foundGround:IsA("Folder") or not foundMechanics or not foundMechanics:IsA("Folder") then
		warn("[Stage8SweeperService] Zone8 Ground/Mechanics missing")
		return
	end

	local foundFloor = foundGround:WaitForChild(ARENA_FLOOR_NAME, 30)
	local foundStart = foundMechanics:WaitForChild(STAGE_START_NAME, 30)
	local foundArm = foundMechanics:WaitForChild(SWEEPER_ARM_NAME, 30)
	local foundHinge = foundMechanics:FindFirstChild(HINGE_NAME)
	if not foundFloor or not foundFloor:IsA("BasePart") or not foundStart or not foundStart:IsA("BasePart") or not foundArm or not foundArm:IsA("BasePart") then
		warn("[Stage8SweeperService] Stage8 floor/start/sweeper missing")
		return
	end

	arenaFloor = foundFloor
	stageStart = foundStart
	sweeperArm = foundArm
	spinnerHinge = if foundHinge and foundHinge:IsA("HingeConstraint") then foundHinge else nil
	sweepCenter = Vector3.new(foundFloor.Position.X, foundArm.Position.Y, foundFloor.Position.Z)
	baseArmCFrame = CFrame.new(foundArm.Position) * (foundArm.CFrame - foundArm.Position)
	sweepAngle = 0

	configureHinge()
	configureParts()
	ensureRotationArrows(foundMechanics)

	stageStart.Touched:Connect(function(hit: BasePart)
		if hit:IsA("BasePart") then
			markStage8Started(hit)
		end
	end)

	RunService.Heartbeat:Connect(function(dt: number)
		updateSweeper(dt)
		local now = os.clock()
		if now - lastHitCheckTime >= HIT_CHECK_INTERVAL_SECONDS then
			lastHitCheckTime = now
			processSweeperHits()
		end
	end)

	Players.PlayerRemoving:Connect(function(player: Player)
		lastKillTimes[player] = nil
	end)

	script:SetAttribute("Started", true)
end

return Stage8SweeperService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="136">
          <Properties>
            <string name="Name">StageCheckpointService</string>
            <string name="Source"><![CDATA[--!strict
local AdService = game:GetService("AdService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Constants = require(ReplicatedStorage.Shared.Constants)
local GamePackets = require(ReplicatedStorage.Shared.Network.GamePackets)

local DataService = require(script.Parent.DataService)
local ProgressionService = require(script.Parent.ProgressionService)

local STAGE_TOUCH_DISTANCE = 55
local STAGE_TOUCH_COOLDOWN_SECONDS = 1.5
local REVIVE_ROOT_HEIGHT = 4
local REVIVE_PENDING_GRACE_SECONDS = 120

type PendingRevive = {
	stage: number,
	createdAt: number,
	expiresAt: number,
	targetPath: string,
}

local finishCooldowns: { [Player]: { [number]: number } } = {}
local pendingRevives: { [Player]: PendingRevive } = {}
local zone5Event: RemoteEvent?

local StageCheckpointService = {}

local function resolvePath(path: string): Instance?
	local current: Instance = game
	for segment in string.gmatch(path, "[^%.]+") do
		local nextInstance = current:FindFirstChild(segment)
		if not nextInstance then
			return nil
		end
		current = nextInstance
	end

	return current
end

local function getStagePath(stage: number, partName: string): string
	return `Workspace.Zone{stage}.Mechanics.Stage{stage}{partName}`
end

local function getPlayerFromHit(hit: BasePart): Player?
	local character = hit:FindFirstAncestorOfClass("Model")
	if not character then
		return nil
	end

	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not humanoid or humanoid.Health <= 0 then
		return nil
	end

	return Players:GetPlayerFromCharacter(character)
end

local function getCharacterRoot(player: Player): BasePart?
	local character = player.Character
	if not character then
		return nil
	end

	local humanoid = character:FindFirstChildOfClass("Humanoid")
	local root = character:FindFirstChild("HumanoidRootPart")
	if not humanoid or humanoid.Health <= 0 or not root or not root:IsA("BasePart") then
		return nil
	end

	return root
end

local function getTargetCFrame(targetPath: string): CFrame?
	local target = resolvePath(targetPath)
	if not target then
		return nil
	end

	if target:IsA("BasePart") then
		return target.CFrame + Vector3.new(0, (target.Size.Y * 0.5) + REVIVE_ROOT_HEIGHT, 0)
	end
	if target:IsA("Model") then
		local _, size = target:GetBoundingBox()
		return target:GetPivot() + Vector3.new(0, (size.Y * 0.5) + REVIVE_ROOT_HEIGHT, 0)
	end

	return nil
end

local function sendToast(player: Player, message: string, amount: number?)
	GamePackets.toast.sendTo({
		kind = "stage",
		message = message,
		amount = amount or 0,
	}, player)
end

local function syncStageAttributes(player: Player)
	local data = DataService.GetData(player)
	local highestCompleted = if data then math.floor((data :: any).HighestCompletedStage or 0) else 0
	player:SetAttribute("HighestCompletedStage", highestCompleted)
	if typeof(player:GetAttribute("CurrentStage")) ~= "number" then
		player:SetAttribute("CurrentStage", math.clamp(highestCompleted + 1, 1, Constants.MAX_CONFIGURED_STAGE))
	end
end

local function setActiveStage(player: Player, stage: number)
	local clampedStage = math.clamp(stage, 0, Constants.MAX_CONFIGURED_STAGE)
	player:SetAttribute("ActiveStage", clampedStage)
	if clampedStage > 0 then
		player:SetAttribute("CurrentStage", clampedStage)
	else
		player:SetAttribute("CurrentStage", 0)
	end
end

local function isTouchNearPart(player: Player, part: BasePart): boolean
	local root = getCharacterRoot(player)
	if not root then
		return false
	end

	return (root.Position - part.Position).Magnitude <= STAGE_TOUCH_DISTANCE
end

local function onStageStartTouched(stage: number, startPart: BasePart, hit: BasePart)
	local player = getPlayerFromHit(hit)
	if not player or not isTouchNearPart(player, startPart) then
		return
	end

	setActiveStage(player, stage)
	syncStageAttributes(player)
end

local function completeStage(player: Player, stage: number): boolean
	local data = DataService.GetData(player)
	if not data then
		sendToast(player, "Data still loading")
		return false
	end

	local dataTable = data :: any
	local previousHighest = math.floor(dataTable.HighestCompletedStage or 0)
	if stage <= previousHighest then
		setActiveStage(player, math.min(stage + 1, Constants.MAX_CONFIGURED_STAGE))
		return false
	end

	dataTable.HighestCompletedStage = stage
	player:SetAttribute("HighestCompletedStage", stage)
	player:SetAttribute("CompletedStage", stage)
	setActiveStage(player, math.min(stage + 1, Constants.MAX_CONFIGURED_STAGE))

	local rewardWins = Constants.STAGE_WINS[stage] or 0
	if rewardWins > 0 then
		ProgressionService.AwardWins(player, rewardWins, "stage")
	else
		ProgressionService.SendSnapshot(player)
	end
	DataService.UpdateLeaderstats(player)

	if stage == 5 and zone5Event then
		local finishPart = resolvePath(getStagePath(stage, "Finish"))
		if finishPart and finishPart:IsA("BasePart") then
			zone5Event:FireClient(player, "Victory", finishPart.Position)
		end
	end

	return true
end

local function onStageFinishTouched(stage: number, finishPart: BasePart, hit: BasePart)
	local player = getPlayerFromHit(hit)
	if not player or not isTouchNearPart(player, finishPart) then
		return
	end

	local now = os.clock()
	local playerCooldowns = finishCooldowns[player]
	if not playerCooldowns then
		playerCooldowns = {}
		finishCooldowns[player] = playerCooldowns
	end
	if now - (playerCooldowns[stage] or 0) < STAGE_TOUCH_COOLDOWN_SECONDS then
		return
	end
	playerCooldowns[stage] = now

	completeStage(player, stage)
end

local function connectTouched(part: BasePart, callback: (BasePart) -> ())
	part.Touched:Connect(function(hit: BasePart)
		if hit:IsA("BasePart") then
			callback(hit)
		end
	end)
end

local function teleportPlayerToPendingRevive(player: Player, pending: PendingRevive): boolean
	local root = getCharacterRoot(player)
	local targetCFrame = getTargetCFrame(pending.targetPath)
	if not root or not targetCFrame then
		return false
	end

	root.AssemblyLinearVelocity = Vector3.zero
	root.AssemblyAngularVelocity = Vector3.zero
	root.CFrame = targetCFrame
	setActiveStage(player, pending.stage)
	pendingRevives[player] = nil
	GamePackets.reviveClosed.sendTo({ reason = "granted" }, player)
	sendToast(player, `Revived at Stage {pending.stage}`)
	return true
end

local function offerRevive(player: Player, stage: number)
	local targetPath = getStagePath(stage, "Start")
	if not resolvePath(targetPath) then
		return
	end

	local now = os.clock()
	pendingRevives[player] = {
		stage = stage,
		createdAt = now,
		expiresAt = now + Constants.REVIVE_PROMPT_SECONDS,
		targetPath = targetPath,
	}

	GamePackets.reviveOffer.sendTo({
		stage = math.clamp(stage, 0, 255),
		durationSeconds = math.clamp(Constants.REVIVE_PROMPT_SECONDS, 0, 255),
		robuxProductId = Constants.REVIVE_PRODUCT_ID,
		robuxPrice = math.clamp(Constants.REVIVE_ROBUX_PRICE, 0, 65535),
		adRewardProductId = Constants.REVIVE_PRODUCT_ID,
	}, player)
end

local function onHumanoidDied(player: Player)
	local activeStage = player:GetAttribute("ActiveStage")
	if typeof(activeStage) ~= "number" or activeStage < 1 or activeStage > Constants.MAX_CONFIGURED_STAGE then
		return
	end

	setActiveStage(player, 0)
	offerRevive(player, activeStage)
end

local function watchCharacter(player: Player, character: Model)
	task.defer(function()
		local humanoid = character:FindFirstChildOfClass("Humanoid") or character:WaitForChild("Humanoid", 8)
		if humanoid and humanoid:IsA("Humanoid") then
			humanoid.Died:Connect(function()
				onHumanoidDied(player)
			end)
		end
	end)
end

local function handleAdRevive(player: Player, pending: PendingRevive)
	if Constants.REVIVE_PRODUCT_ID <= 0 then
		sendToast(player, "Set revive product id before ads")
		return
	end
	if os.clock() > pending.expiresAt then
		sendToast(player, "Revive expired")
		return
	end

	local success, result = pcall(function()
		local reward = AdService:CreateAdRewardFromDevProductId(Constants.REVIVE_PRODUCT_ID)
		if Constants.REVIVE_AD_PLACEMENT_ID > 0 then
			return AdService:ShowRewardedVideoAdAsync(player, reward, Constants.REVIVE_AD_PLACEMENT_ID)
		end
		return AdService:ShowRewardedVideoAdAsync(player, reward)
	end)

	if not success then
		sendToast(player, "Ad not available")
		return
	end
	if result ~= Enum.ShowAdResult.ShowCompleted then
		sendToast(player, "Ad not completed")
	end
end

function StageCheckpointService.ProcessReceipt(receiptInfo: { [string]: any }): Enum.ProductPurchaseDecision
	if Constants.REVIVE_PRODUCT_ID <= 0 or receiptInfo.ProductId ~= Constants.REVIVE_PRODUCT_ID then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end

	local player = Players:GetPlayerByUserId(receiptInfo.PlayerId)
	if not player then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end

	local pending = pendingRevives[player]
	if not pending or os.clock() - pending.createdAt > REVIVE_PENDING_GRACE_SECONDS then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end

	if teleportPlayerToPendingRevive(player, pending) then
		return Enum.ProductPurchaseDecision.PurchaseGranted
	end

	return Enum.ProductPurchaseDecision.NotProcessedYet
end

function StageCheckpointService.Init()
	local existingEvent = ReplicatedStorage:FindFirstChild("Zone5Event")
	if existingEvent and existingEvent:IsA("RemoteEvent") then
		zone5Event = existingEvent
	else
		local event = Instance.new("RemoteEvent")
		event.Name = "Zone5Event"
		event.Parent = ReplicatedStorage
		zone5Event = event
	end
end

function StageCheckpointService.Start()
	for stage = 1, Constants.MAX_CONFIGURED_STAGE do
		local startPart = resolvePath(getStagePath(stage, "Start"))
		local finishPart = resolvePath(getStagePath(stage, "Finish"))

		if startPart and startPart:IsA("BasePart") then
			connectTouched(startPart, function(hit: BasePart)
				onStageStartTouched(stage, startPart, hit)
			end)
		else
			warn(`[StageCheckpointService] Missing Stage{stage}Start`)
		end

		if finishPart and finishPart:IsA("BasePart") then
			connectTouched(finishPart, function(hit: BasePart)
				onStageFinishTouched(stage, finishPart, hit)
			end)
		else
			warn(`[StageCheckpointService] Missing Stage{stage}Finish`)
		end
	end

	GamePackets.requestRevive.listen(function(request, player: Player)
		if typeof(request.method) ~= "string" then
			return
		end

		local pending = pendingRevives[player]
		if not pending then
			sendToast(player, "No revive available")
			return
		end

		if request.method == "ad" then
			handleAdRevive(player, pending)
		elseif request.method == "decline" then
			pendingRevives[player] = nil
			GamePackets.reviveClosed.sendTo({ reason = "declined" }, player)
		end
	end)

	for _, player in Players:GetPlayers() do
		syncStageAttributes(player)
		if player.Character then
			watchCharacter(player, player.Character)
		end
		player.CharacterAdded:Connect(function(character)
			watchCharacter(player, character)
		end)
	end

	Players.PlayerAdded:Connect(function(player)
		syncStageAttributes(player)
		player.CharacterAdded:Connect(function(character)
			watchCharacter(player, character)
		end)
	end)

	Players.PlayerRemoving:Connect(function(player)
		finishCooldowns[player] = nil
		pendingRevives[player] = nil
	end)
end

return StageCheckpointService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="137">
          <Properties>
            <string name="Name">TeleportService</string>
            <string name="Source"><![CDATA[--!strict
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Constants = require(ReplicatedStorage.Shared.Constants)
local GamePackets = require(ReplicatedStorage.Shared.Network.GamePackets)
local DataService = require(script.Parent.DataService)

local TELEPORT_COOLDOWN_SECONDS = 1.25
local TELEPORT_ROOT_HEIGHT = 3
local TELEPORT_FACING_CORRECTION = CFrame.Angles(0, math.pi, 0)

type DestinationConfig = {
	id: string,
	name: string,
	description: string,
	targetPath: string,
	accentColor: Color3,
	sortOrder: number,
	priceWins: number,
	priceRobux: number,
	productId: number,
}

local lastTeleportTimeByPlayer: { [Player]: number } = {}
local destinationById: { [string]: DestinationConfig } = {}
local destinationByProductId: { [number]: DestinationConfig } = {}

local TeleportService = {}

local function isTeleportDestinationEnabled(destination: DestinationConfig): boolean
	return destination.targetPath ~= ""
end

local function resolvePath(path: string): Instance?
	local current: Instance = game
	for segment in string.gmatch(path, "[^%.]+") do
		local nextInstance = current:FindFirstChild(segment)
		if not nextInstance then
			return nil
		end
		current = nextInstance
	end

	return current
end

local function getCharacterRoot(player: Player): BasePart?
	local character = player.Character
	if not character then
		return nil
	end

	local humanoid = character:FindFirstChildOfClass("Humanoid")
	local root = character:FindFirstChild("HumanoidRootPart")
	if not humanoid or humanoid.Health <= 0 or not root or not root:IsA("BasePart") then
		return nil
	end

	return root
end

local function getDestinationCFrame(destination: DestinationConfig): CFrame?
	local target = resolvePath(destination.targetPath)
	if not target then
		return nil
	end

	if target:IsA("BasePart") then
		return (target.CFrame + Vector3.new(0, (target.Size.Y * 0.5) + TELEPORT_ROOT_HEIGHT, 0))
			* TELEPORT_FACING_CORRECTION
	end
	if target:IsA("Model") then
		local _, size = target:GetBoundingBox()
		return (target:GetPivot() + Vector3.new(0, (size.Y * 0.5) + TELEPORT_ROOT_HEIGHT, 0))
			* TELEPORT_FACING_CORRECTION
	end

	return nil
end

local function teleportPlayer(player: Player, destination: DestinationConfig)
	local now = os.clock()
	if now - (lastTeleportTimeByPlayer[player] or 0) < TELEPORT_COOLDOWN_SECONDS then
		return
	end
	lastTeleportTimeByPlayer[player] = now

	local root = getCharacterRoot(player)
	local destinationCFrame = getDestinationCFrame(destination)
	if not root or not destinationCFrame then
		return
	end

	root.AssemblyLinearVelocity = Vector3.zero
	root.AssemblyAngularVelocity = Vector3.zero
	root.CFrame = destinationCFrame
	player:SetAttribute("CurrentTeleportDestination", destination.id)
	if destination.id == "lobby" or destination.id == "training" then
		player:SetAttribute("ActiveStage", 0)
	else
		local stageText = destination.id:match("^stage_(%d+)$")
		local stageNumber = stageText and tonumber(stageText)
		if stageNumber then
			player:SetAttribute("ActiveStage", stageNumber)
			player:SetAttribute("CurrentStage", stageNumber)
		end
	end

	GamePackets.toast.sendTo({
		kind = "teleport",
		message = `Teleported to {destination.name}`,
		amount = 0,
	}, player)
end

local function tryPayWins(player: Player, destination: DestinationConfig): boolean
	local data = DataService.GetData(player)
	if not data then
		GamePackets.toast.sendTo({
			kind = "teleport",
			message = "Data still loading",
			amount = 0,
		}, player)
		return false
	end

	local priceWins = math.max(0, destination.priceWins)
	if data.TotalWins < priceWins then
		GamePackets.toast.sendTo({
			kind = "teleport",
			message = "Not enough Wins",
			amount = 0,
		}, player)
		return false
	end

	data.TotalWins -= priceWins
	DataService.UpdateLeaderstats(player)
	return true
end

function TeleportService.ProcessReceipt(receiptInfo: { PlayerId: number, ProductId: number }): Enum.ProductPurchaseDecision
	local destination = destinationByProductId[receiptInfo.ProductId]
	if not destination then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end

	local player = Players:GetPlayerByUserId(receiptInfo.PlayerId)
	if not player then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end

	local root = getCharacterRoot(player)
	local destinationCFrame = getDestinationCFrame(destination)
	if not root or not destinationCFrame then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end

	teleportPlayer(player, destination)
	return Enum.ProductPurchaseDecision.PurchaseGranted
end

function TeleportService.Init()
	table.clear(destinationById)
	table.clear(destinationByProductId)
	for _, destination in Constants.TELEPORT_DESTINATIONS do
		if isTeleportDestinationEnabled(destination) then
			destinationById[destination.id] = destination
		end
		if isTeleportDestinationEnabled(destination) and destination.productId > 0 then
			destinationByProductId[destination.productId] = destination
		end
	end
end

function TeleportService.Start()
	GamePackets.requestTeleport.listen(function(request, player: Player)
		if typeof(request.destinationId) ~= "string" then
			return
		end
		if typeof(request.paymentKind) ~= "string" then
			return
		end

		local destination = destinationById[request.destinationId]
		if not destination then
			return
		end

		if request.paymentKind ~= "wins" then
			GamePackets.toast.sendTo({
				kind = "teleport",
				message = "Choose Wins or Robux",
				amount = 0,
			}, player)
			return
		end

		if not tryPayWins(player, destination) then
			return
		end

		teleportPlayer(player, destination)
	end)

	Players.PlayerRemoving:Connect(function(player)
		lastTeleportTimeByPlayer[player] = nil
	end)
end

return TeleportService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="138">
          <Properties>
            <string name="Name">Zone2MechanicsService</string>
            <string name="Source"><![CDATA[--!strict

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Zone2MechanicsService = {}

local ZONE_NAME = "Zone2"
local MECHANICS_NAME = "Mechanics"
local PIVOT_NAME = "Pivot"
local KILL_COOLDOWN_SECONDS = 0.85

type LaserDefaults = {
	rpm: number,
	dir: number,
	pivotZ: number,
}

type LaserConfig = {
	model: Model,
	pivot: BasePart,
	rpm: number,
	dir: number,
	pivotX: number,
	pivotY: number,
	pivotZ: number,
	angle: number,
}

local LASER_DEFAULTS: { [string]: LaserDefaults } = {
	LaserSweeper1 = { rpm = 18, dir = 1, pivotZ = 495 },
	LaserSweeper2 = { rpm = 22, dir = -1, pivotZ = 763 },
	Laser2_1 = { rpm = 28, dir = 1, pivotZ = 629 },
	Laser2_2 = { rpm = 32, dir = -1, pivotZ = 897 },
	Laser2_3 = { rpm = 38, dir = 1, pivotZ = 1031 },
}

local lasers: { LaserConfig } = {}
local configuredModels: { [Model]: boolean } = {}
local lastKillTimes: { [Player]: number } = {}

local function getNumberAttribute(instance: Instance?, attributeName: string, fallback: number): number
	if not instance then
		return fallback
	end

	local value = instance:GetAttribute(attributeName)
	if type(value) == "number" then
		return value
	end

	return fallback
end

local function getPlayerFromHit(hit: BasePart): (Player?, Humanoid?)
	local character = hit:FindFirstAncestorOfClass("Model")
	if not character then
		return nil, nil
	end

	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not humanoid then
		return nil, nil
	end

	return Players:GetPlayerFromCharacter(character), humanoid
end

local function killPlayerFromHit(hit: BasePart)
	local player, humanoid = getPlayerFromHit(hit)
	if not player or not humanoid or humanoid.Health <= 0 then
		return
	end

	local now = os.clock()
	local lastKillTime = lastKillTimes[player] or 0
	if now - lastKillTime < KILL_COOLDOWN_SECONDS then
		return
	end

	lastKillTimes[player] = now
	humanoid.Health = 0
end

local function connectLaserBeam(beam: BasePart)
	beam.CanTouch = true
	beam.CanQuery = true
	beam.CanCollide = false
	beam.Touched:Connect(killPlayerFromHit)
end

local function isLaserBeam(part: BasePart, pivot: BasePart): boolean
	if part == pivot then
		return false
	end

	local lowerName = string.lower(part.Name)
	return string.find(lowerName, "beam", 1, true) ~= nil or string.find(lowerName, "laser", 1, true) ~= nil
end

local function configureLaserModel(model: Model)
	if configuredModels[model] then
		return
	end

	local pivot = model:FindFirstChild(PIVOT_NAME)
	if not pivot or not pivot:IsA("BasePart") then
		return
	end

	local defaults = LASER_DEFAULTS[model.Name]
	if not defaults then
		return
	end

	local legacyScript = model:FindFirstChildWhichIsA("Script")
	local rpm = getNumberAttribute(model, "RPM", defaults.rpm)
	local dir = getNumberAttribute(model, "Dir", defaults.dir)
	local pivotZ = getNumberAttribute(model, "PivotZ", defaults.pivotZ)

	rpm = getNumberAttribute(legacyScript, "RPM", rpm)
	dir = getNumberAttribute(legacyScript, "Dir", dir)
	pivotZ = getNumberAttribute(legacyScript, "PivotZ", pivotZ)

	if legacyScript then
		legacyScript.Disabled = true
	end

	for _, descendant in model:GetDescendants() do
		if descendant:IsA("BasePart") and isLaserBeam(descendant, pivot) then
			connectLaserBeam(descendant)
		end
	end

	configuredModels[model] = true
	model:SetAttribute("ManagedByZone2MechanicsService", true)
	table.insert(lasers, {
		model = model,
		pivot = pivot,
		rpm = rpm,
		dir = dir,
		pivotX = pivot.Position.X,
		pivotY = pivot.Position.Y,
		pivotZ = pivotZ,
		angle = 0,
	})
	script:SetAttribute("LaserCount", #lasers)
end

function Zone2MechanicsService.Init()
	script:SetAttribute("Started", false)
	script:SetAttribute("LaserCount", 0)
end

function Zone2MechanicsService.Start()
	local zone = Workspace:WaitForChild(ZONE_NAME, 30)
	if not zone then
		warn("[Zone2MechanicsService] Workspace.Zone2 not found")
		return
	end

	local mechanics = zone:WaitForChild(MECHANICS_NAME, 30)
	if not mechanics then
		warn("[Zone2MechanicsService] Workspace.Zone2.Mechanics not found")
		return
	end

	for _, child in mechanics:GetChildren() do
		if child:IsA("Model") then
			configureLaserModel(child)
		end
	end

	mechanics.ChildAdded:Connect(function(child: Instance)
		if child:IsA("Model") then
			task.defer(configureLaserModel, child)
		end
	end)

	Players.PlayerRemoving:Connect(function(player: Player)
		lastKillTimes[player] = nil
	end)

	script:SetAttribute("LaserCount", #lasers)
	script:SetAttribute("Started", true)

	RunService.Heartbeat:Connect(function(deltaTime: number)
		for _, laser in lasers do
			if laser.pivot.Parent then
				laser.angle += laser.dir * (laser.rpm / 60) * 360 * deltaTime
				laser.pivot.CFrame = CFrame.new(laser.pivotX, laser.pivotY, laser.pivotZ)
					* CFrame.Angles(0, math.rad(laser.angle), 0)
			end
		end
	end)
end

return Zone2MechanicsService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="139">
          <Properties>
            <string name="Name">Zone7GravityService</string>
            <string name="Source"><![CDATA[--!strict
local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local Zone7GravityService = {}

local ZONE_NAME = "Zone7"
local GROUND_NAME = "Ground"
local MECHANICS_NAME = "Mechanics"
local STAGE_START_NAME = "Stage7Start"
local STAGE_FINISH_NAME = "Stage7Finish"
local GRAVITY_ZONES_NAME = "GravityZones"
local KILL_FLOOR_NAME = "KillFloor"
local LEGACY_ZONE_CONTROLLER_NAME = "Zone7Controller"
local LEGACY_KILL_LOGIC_NAME = "KillLogic"

local STAGE_NUMBER = 7
local GRAVITY_ATTRIBUTE = "Zone7GravityEnabled"
local MIN_LEVEL_TO_RUN = 61
local MIN_WALK_SPEED_TO_RUN = 126
local TOUCH_COOLDOWN_SECONDS = 0.6
local COLLAPSE_SPEED_STUDS_PER_SECOND = 126
local PLATFORM_LENGTH_STUDS = 10
local COLLAPSE_START_DELAY_SECONDS = 0.8
local COLLAPSE_RESET_DELAY_SECONDS = 4
local COLLAPSE_TWEEN_SECONDS = 0.3
local COLLAPSE_DROP_STUDS = 40

type PartState = {
	CFrame: CFrame,
	Size: Vector3,
	CanCollide: boolean,
	CanTouch: boolean,
	Transparency: number,
	Color: Color3,
}

type PlatformEntry = {
	index: number,
	instance: Instance,
	parts: { BasePart },
	states: { [BasePart]: PartState },
}

local ground: Folder?
local mechanics: Folder?
local stageStart: BasePart?
local stageFinish: BasePart?
local gravityZones: Folder?
local killFloor: BasePart?
local platforms: { PlatformEntry } = {}
local activeGravityPlayers: { [Player]: boolean } = {}
local touchCooldowns: { [Player]: number } = {}
local isCollapsing = false
local collapseGeneration = 0

local function getPlayerFromHit(hit: BasePart): (Player?, Humanoid?)
	local character = hit:FindFirstAncestorOfClass("Model")
	if not character then
		return nil, nil
	end

	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not humanoid or humanoid.Health <= 0 then
		return nil, nil
	end

	local player = Players:GetPlayerFromCharacter(character)
	if not player then
		return nil, nil
	end

	return player, humanoid
end

local function shouldAcceptTouch(player: Player): boolean
	local now = os.clock()
	if now - (touchCooldowns[player] or 0) < TOUCH_COOLDOWN_SECONDS then
		return false
	end

	touchCooldowns[player] = now
	return true
end

local function getActivePlayerCount(): number
	local count = 0
	for _ in activeGravityPlayers do
		count += 1
	end

	return count
end

local function setGravityActive(player: Player, isActive: boolean)
	if isActive then
		activeGravityPlayers[player] = true
		player:SetAttribute("ActiveStage", STAGE_NUMBER)
		player:SetAttribute("CurrentStage", STAGE_NUMBER)
	else
		activeGravityPlayers[player] = nil
	end

	player:SetAttribute(GRAVITY_ATTRIBUTE, isActive)
	script:SetAttribute("ActivePlayerCount", getActivePlayerCount())
end

local function deactivatePlayer(player: Player)
	if activeGravityPlayers[player] then
		setGravityActive(player, false)
	else
		player:SetAttribute(GRAVITY_ATTRIBUTE, false)
	end
end

local function syncGravityWithStage(player: Player)
	local activeStage = player:GetAttribute("ActiveStage")
	local currentStage = player:GetAttribute("CurrentStage")
	if activeGravityPlayers[player] and activeStage ~= STAGE_NUMBER and currentStage ~= STAGE_NUMBER then
		deactivatePlayer(player)
	end
end

local function disableLegacyScript(parent: Instance?, scriptName: string, disabledName: string)
	local legacyScript = parent and parent:FindFirstChild(scriptName)
	if legacyScript and legacyScript:IsA("BaseScript") then
		legacyScript.Disabled = true
		legacyScript.Name = disabledName
	end
end

local function getLevel(player: Player): number
	local leaderstats = player:FindFirstChild("leaderstats")
	local levelValue = leaderstats and leaderstats:FindFirstChild("Level")
	if levelValue and levelValue:IsA("IntValue") then
		return levelValue.Value
	end
	if levelValue and levelValue:IsA("NumberValue") then
		return levelValue.Value
	end

	return 1
end

local function isPlayerQualified(player: Player, humanoid: Humanoid): boolean
	return getLevel(player) >= MIN_LEVEL_TO_RUN and humanoid.WalkSpeed >= MIN_WALK_SPEED_TO_RUN
end

local function capturePartState(part: BasePart): PartState
	return {
		CFrame = part.CFrame,
		Size = part.Size,
		CanCollide = part.CanCollide,
		CanTouch = part.CanTouch,
		Transparency = part.Transparency,
		Color = part.Color,
	}
end

local function collectPlatformParts(instance: Instance): { BasePart }
	local parts = {}
	if instance:IsA("BasePart") then
		table.insert(parts, instance)
		return parts
	end

	for _, descendant in instance:GetDescendants() do
		if descendant:IsA("BasePart") then
			table.insert(parts, descendant)
		end
	end

	return parts
end

local function collectPlatforms(foundGround: Folder): { PlatformEntry }
	local collected = {}

	for _, child in foundGround:GetChildren() do
		local platformIndex = tonumber(child.Name:match("^Platform_(%d+)$"))
		if platformIndex then
			local parts = collectPlatformParts(child)
			local states = {}
			for _, part in parts do
				states[part] = capturePartState(part)
			end

			table.insert(collected, {
				index = platformIndex,
				instance = child,
				parts = parts,
				states = states,
			})
		end
	end

	table.sort(collected, function(left: PlatformEntry, right: PlatformEntry)
		return left.index < right.index
	end)

	return collected
end

local function restorePlatform(entry: PlatformEntry)
	for _, part in entry.parts do
		local state = entry.states[part]
		if state and part.Parent then
			part.CFrame = state.CFrame
			part.Size = state.Size
			part.CanCollide = state.CanCollide
			part.CanTouch = state.CanTouch
			part.Transparency = state.Transparency
			part.Color = state.Color
		end
	end
end

local function resetTrack()
	collapseGeneration += 1
	for _, entry in platforms do
		restorePlatform(entry)
	end

	isCollapsing = false
	script:SetAttribute("Collapsing", false)
end

local function collapsePlatform(entry: PlatformEntry)
	for _, part in entry.parts do
		if part.Parent and part.CanCollide then
			part.CanCollide = false
			part.CanTouch = false
			local tween = TweenService:Create(part, TweenInfo.new(COLLAPSE_TWEEN_SECONDS, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
				CFrame = part.CFrame - Vector3.new(0, COLLAPSE_DROP_STUDS, 0),
				Transparency = 1,
			})
			tween:Play()
		end
	end
end

local function startCollapse()
	if isCollapsing then
		return
	end

	isCollapsing = true
	collapseGeneration += 1
	local generation = collapseGeneration
	script:SetAttribute("Collapsing", true)

	task.spawn(function()
		task.wait(COLLAPSE_START_DELAY_SECONDS)
		local interval = PLATFORM_LENGTH_STUDS / COLLAPSE_SPEED_STUDS_PER_SECOND

		for _, entry in platforms do
			if not isCollapsing or generation ~= collapseGeneration then
				return
			end

			collapsePlatform(entry)
			task.wait(interval)
		end

		task.wait(COLLAPSE_RESET_DELAY_SECONDS)
		if generation == collapseGeneration then
			resetTrack()
		end
	end)
end

local function onStageStartTouched(hit: BasePart)
	local player, humanoid = getPlayerFromHit(hit)
	if not player or not humanoid or not shouldAcceptTouch(player) then
		return
	end

	setGravityActive(player, true)
end

local function onStageFinishTouched(hit: BasePart)
	local player = getPlayerFromHit(hit)
	if player then
		deactivatePlayer(player)
	end
end

local function onKillFloorTouched(hit: BasePart)
	local player, humanoid = getPlayerFromHit(hit)
	if player and humanoid then
		humanoid.Health = 0
	end
end

local function onPlatformTouched(entry: PlatformEntry, hit: BasePart)
	local player, humanoid = getPlayerFromHit(hit)
	if not player or not humanoid or not shouldAcceptTouch(player) then
		return
	end

	setGravityActive(player, true)
	if not isPlayerQualified(player, humanoid) then
		collapsePlatform(entry)
		return
	end

	startCollapse()
end

local function connectGravityZone(zonePart: BasePart)
	zonePart.Touched:Connect(function(hit: BasePart)
		local player = getPlayerFromHit(hit)
		if player then
			setGravityActive(player, true)
		end
	end)
end

local function watchCharacter(player: Player, character: Model)
	deactivatePlayer(player)
	local humanoid = character:FindFirstChildOfClass("Humanoid") or character:WaitForChild("Humanoid", 8)
	if humanoid and humanoid:IsA("Humanoid") then
		humanoid.Died:Connect(function()
			deactivatePlayer(player)
		end)
	end
end

local function watchPlayer(player: Player)
	if player.Character then
		watchCharacter(player, player.Character)
	end

	player.CharacterAdded:Connect(function(character: Model)
		watchCharacter(player, character)
	end)

	player:GetAttributeChangedSignal("ActiveStage"):Connect(function()
		syncGravityWithStage(player)
	end)

	player:GetAttributeChangedSignal("CurrentStage"):Connect(function()
		syncGravityWithStage(player)
	end)
end

function Zone7GravityService.Init()
	script:SetAttribute("Started", false)
	script:SetAttribute("Collapsing", false)
	script:SetAttribute("PlatformCount", 0)
	script:SetAttribute("ActivePlayerCount", 0)
end

function Zone7GravityService.Start()
	local zone = Workspace:WaitForChild(ZONE_NAME, 30)
	if not zone then
		warn("[Zone7GravityService] Workspace.Zone7 not found")
		return
	end

	disableLegacyScript(zone, LEGACY_ZONE_CONTROLLER_NAME, "Zone7Controller_DISABLED_OLD")

	local foundGround = zone:WaitForChild(GROUND_NAME, 30)
	if not foundGround or not foundGround:IsA("Folder") then
		warn("[Zone7GravityService] Workspace.Zone7.Ground not found")
		return
	end
	ground = foundGround

	local foundMechanics = zone:WaitForChild(MECHANICS_NAME, 30)
	if not foundMechanics or not foundMechanics:IsA("Folder") then
		warn("[Zone7GravityService] Workspace.Zone7.Mechanics not found")
		return
	end
	mechanics = foundMechanics

	local foundStageStart = foundMechanics:WaitForChild(STAGE_START_NAME, 30)
	local foundStageFinish = foundMechanics:WaitForChild(STAGE_FINISH_NAME, 30)
	if not foundStageStart or not foundStageStart:IsA("BasePart") then
		warn("[Zone7GravityService] Stage7Start not found")
		return
	end
	if not foundStageFinish or not foundStageFinish:IsA("BasePart") then
		warn("[Zone7GravityService] Stage7Finish not found")
		return
	end

	stageStart = foundStageStart
	stageFinish = foundStageFinish
	stageStart.Touched:Connect(onStageStartTouched)
	stageFinish.Touched:Connect(onStageFinishTouched)

	local foundGravityZones = foundMechanics:FindFirstChild(GRAVITY_ZONES_NAME)
	if foundGravityZones and foundGravityZones:IsA("Folder") then
		gravityZones = foundGravityZones
		for _, child in foundGravityZones:GetChildren() do
			if child:IsA("BasePart") then
				connectGravityZone(child)
			end
		end
	end

	local foundKillFloor = foundMechanics:FindFirstChild(KILL_FLOOR_NAME)
	if foundKillFloor and foundKillFloor:IsA("BasePart") then
		killFloor = foundKillFloor
		disableLegacyScript(foundKillFloor, LEGACY_KILL_LOGIC_NAME, "KillLogic_DISABLED_OLD")
		killFloor.Touched:Connect(onKillFloorTouched)
	end

	platforms = collectPlatforms(foundGround)
	for _, entry in platforms do
		for _, part in entry.parts do
			part.Touched:Connect(function(hit: BasePart)
				onPlatformTouched(entry, hit)
			end)
		end
	end

	for _, player in Players:GetPlayers() do
		player:SetAttribute(GRAVITY_ATTRIBUTE, false)
		watchPlayer(player)
	end

	Players.PlayerAdded:Connect(function(player: Player)
		player:SetAttribute(GRAVITY_ATTRIBUTE, false)
		watchPlayer(player)
	end)

	Players.PlayerRemoving:Connect(function(player: Player)
		activeGravityPlayers[player] = nil
		touchCooldowns[player] = nil
	end)

	script:SetAttribute("PlatformCount", #platforms)
	script:SetAttribute("Started", true)
end

return Zone7GravityService
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
    <Item class="Folder" referent="140">
      <Properties>
        <string name="Name">ServerPackages</string>
      </Properties>
      <Item class="ModuleScript" referent="141">
        <Properties>
          <string name="Name">ProfileStore</string>
          <string name="Source"><![CDATA[return require(script.Parent._Index["lm-loleris_profilestore@1.0.3"]["profilestore"])
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="142">
        <Properties>
          <string name="Name">_Index</string>
        </Properties>
        <Item class="Folder" referent="143">
          <Properties>
            <string name="Name">lm-loleris_profilestore@1.0.3</string>
          </Properties>
          <Item class="ModuleScript" referent="144">
            <Properties>
              <string name="Name">profilestore</string>
              <string name="Source">--[[
MAD STUDIO (by loleris)

-[ProfileStore]---------------------------------------

	Periodic DataStore saving solution with session locking
	
	WARNINGS FOR "Profile.Data" VALUES:
	 	! Do not create numeric tables with gaps - attempting to store such tables will result in an error.
		! Do not create mixed tables (some values indexed by number and others by a string key)
			- only numerically indexed  data will be stored.
		! Do not index tables by anything other than numbers and strings.
		! Do not reference Roblox Instances
		! Do not reference userdata (Vector3, Color3, CFrame...) - Serialize userdata before referencing
		! Do not reference functions
		
	Members:
	
		ProfileStore.IsClosing          [bool]
			-- Set to true after a game:BindToClose() trigger
			
		ProfileStore.IsCriticalState    [bool]
			-- Set to true when ProfileStore experiences too many consecutive errors
		
		ProfileStore.OnError            [Signal] (message, store_name, profile_key)
			-- Most ProfileStore errors will be caught and passed to this signal
			
		ProfileStore.OnOverwrite        [Signal] (store_name, profile_key)
			-- Triggered when a DataStore key was likely used to store data that wasn't
			a ProfileStore profile or the ProfileStore structure was invalidly manually
			altered for that DataStore key
			
		ProfileStore.OnCriticalToggle   [Signal] (is_critical)
			-- Triggered when ProfileStore experiences too many consecutive errors
		
		ProfileStore.DataStoreState     [string] ("NotReady", "NoInternet", "NoAccess", "Access")
			-- This value resembles ProfileStore's access to the DataStore; The value starts
			as "NotReady" and will eventually change to one of the other 3 possible values.
	
	Functions:
	
		ProfileStore.New(store_name, template?) --&gt; [ProfileStore]
			store_name   [string] -- DataStore name
			template     [table] or nil -- Profiles will default to given table (hard-copy) when no data was saved previously
			
		ProfileStore.SetConstant(name, value)
			name    [string]
			value   [number]
				
	Members [ProfileStore]:
	
		ProfileStore.Mock   [ProfileStore]
			-- Reflection of ProfileStore methods, but the methods will now query a mock
			DataStore with no relation to the real DataStore
			
		ProfileStore.Name   [string]
		
	Methods [ProfileStore]:
	
		ProfileStore:StartSessionAsync(profile_key, params?) --&gt; [Profile] or nil
			profile_key [string] -- DataStore key
			params      nil or [table]: -- Custom params; E.g. {Steal = true}
				{
					Steal = true, -- Pass this to disregard an existing session lock
					Cancel = fn() -&gt; (boolean), -- Pass this to create a request cancel condition.
						-- If the cancel function returns true, ProfileStore will stop trying to
						-- start the session and return nil
				}
			
		ProfileStore:MessageAsync(profile_key, message) --&gt; is_success [bool]
			profile_key [string] -- DataStore key
			message     [table] -- Data to be messaged to the profile
			
		ProfileStore:GetAsync(profile_key, version?) --&gt; [Profile] or nil
			-- Reads a profile without starting a session - will not autosave
			profile_key   [string] -- DataStore key
			version       nil or [string] -- DataStore key version

		ProfileStore:VersionQuery(profile_key, sort_direction?, min_date?, max_date?) --&gt; [VersionQuery]
			profile_key      [string]
			sort_direction   nil or [Enum.SortDirection]
			min_date         nil or [DateTime]
			max_date         nil or [DateTime]
			
		ProfileStore:RemoveAsync(profile_key) --&gt; is_success [bool]
			-- Completely removes profile data from the DataStore / mock DataStore with no way to recover it.

	Methods [VersionQuery]:

		VersionQuery:NextAsync() --&gt; [Profile] or nil -- (Yields)
			-- Returned profile is similar to profiles returned by ProfileStore:GetAsync()
		
	Members [Profile]:
	
		Profile.Data               [table]
			-- When the profile is active changes to this table are guaranteed to be saved
		Profile.LastSavedData      [table] (Read-only)
			-- Last snapshot of "Profile.Data" that has been successfully saved to the DataStore;
			Useful for proper developer product purchase receipt handling
		
		Profile.FirstSessionTime   [number] (Read-only)
			-- os.time() timestamp of the first profile session
			
		Profile.SessionLoadCount   [number] (Read-only) -- Amount of times a session was started for this profile
			
		Profile.Session            [table] (Read-only) {PlaceId = number, JobId = string} / nil
			-- Set to a table if this profile is in use by a server; nil if released

		Profile.RobloxMetaData     [table] -- Writable table that gets saved automatically and once the profile is released
		Profile.UserIds            [table] -- (Read-only) -- {user_id [number], ...} -- User ids associated with this profile

		Profile.KeyInfo            [DataStoreKeyInfo] -- Changes before OnAfterSave signal
		
		Profile.OnSave             [Signal] ()
			-- Triggered right before changes to Profile.Data are saved to the DataStore
			
		Profile.OnLastSave         [Signal] (reason [string]: "Manual", "External", "Shutdown")
			-- Triggered right before changes to Profile.Data are saved to the DataStore
			for the last time; A reason is provided for the last save:
				- "Manual"   - Profile:EndSession() was called
				- "Shutdown" - The server that has ownership of this profile is shutting down
				- "External" - Another server has started a session for this profile
			Note that this event will not trigger for when a profile session is ended by
			another server trying to take ownership of the session - this is impossible to
			do without compromising on ProfileStore's speed.
			
		Profile.OnSessionEnd       [Signal] ()
			-- Triggered when the profile session is terminated on this server
		
		Profile.OnAfterSave        [Signal] (last_saved_data)
			-- Triggered after a successful save
			last_saved_data [table] -- Profile.LastSavedData
			
		Profile.ProfileStore       [ProfileStore] -- ProfileStore object this profile belongs to
		Profile.Key                [string] -- DataStore key
		
	Methods [Profile]:
	
		Profile:IsActive() --&gt; [bool] -- If "true" is returned, changes to Profile.Data are guaranteed to save;
			This guarantee is only valid until code yields (e.g. task.wait() is used).
			
		Profile:Reconcile() -- Fills in missing (nil) [string_key] = [value] pairs to the Profile.Data structure
			from the "template" argument that was passed to "ProfileStore.New()"
			
		Profile:EndSession() -- Call after the server has finished working with this profile
			e.g., after the player leaves (Profile object will become inactive)

		Profile:AddUserId(user_id) -- Associates user_id with profile (GDPR compliance)
			user_id   [number]

		Profile:RemoveUserId(user_id) -- Removes user_id association with profile (safe function)
			user_id   [number]
			
		Profile:MessageHandler(fn) -- Sets a message handler for this profile
			fn [function] (message [table], processed [function]())
			-- The handler function receives a message table and a callback function;
			The callback function is to be called when a message has been processed
			- this will discard the message from the profile message cache; If the
			callback function is not called, other message handlers will also be triggered
			with unprocessed message data.
			
		Profile:Save() -- If the profile session is still active makes an UpdateAsync call
			to the DataStore to immediately save profile data

		Profile:SetAsync() -- Forcefully saves changes to the profile; Only for profiles
			loaded with ProfileStore:GetAsync() or ProfileStore:VersionQuery()
		
--]]

local AUTO_SAVE_PERIOD = 300 -- (Seconds) Time between when changes to a profile are saved to the DataStore
local LOAD_REPEAT_PERIOD = 10 -- (Seconds) Time between successive profile reads when handling a session conflict
local FIRST_LOAD_REPEAT = 5 -- (Seconds) Time between first and second profile read when handling a session conflict
local SESSION_STEAL = 40 -- (Seconds) Time until a session conflict is resolved with the waiting server stealing the session
local ASSUME_DEAD = 630 -- (Seconds) If a profile hasn't had updates for this long, quickly assume an active session belongs to a crashed server
local START_SESSION_TIMEOUT = 120 -- (Seconds) If a session can't be started for a profile for this long, stop repeating calls to the DataStore

local CRITICAL_STATE_ERROR_COUNT = 5 -- Assume critical state if this many issues happen in a short amount of time
local CRITICAL_STATE_ERROR_EXPIRE = 120 -- (Seconds) Individual issue expiration
local CRITICAL_STATE_EXPIRE = 120 -- (Seconds) Critical state expiration

local MAX_MESSAGE_QUEUE = 1000 -- Max messages saved in a profile that were sent using "ProfileStore:MessageAsync()"

----- Dependencies -----

-- local Util = require(game.ReplicatedStorage.Shared.Util)
-- local Signal = Util.Signal

local Signal do

	local FreeRunnerThread

	--[[
		Yield-safe coroutine reusing by stravant;
		Sources:
		https://devforum.roblox.com/t/lua-signal-class-comparison-optimal-goodsignal-class/1387063
		https://gist.github.com/stravant/b75a322e0919d60dde8a0316d1f09d2f
	--]]

	local function AcquireRunnerThreadAndCallEventHandler(fn, ...)
		local acquired_runner_thread = FreeRunnerThread
		FreeRunnerThread = nil
		fn(...)
		-- The handler finished running, this runner thread is free again.
		FreeRunnerThread = acquired_runner_thread
	end

	local function RunEventHandlerInFreeThread(...)
		AcquireRunnerThreadAndCallEventHandler(...)
		while true do
			AcquireRunnerThreadAndCallEventHandler(coroutine.yield())
		end
	end

	local Connection = {}
	Connection.__index = Connection

	local SignalClass = {}
	SignalClass.__index = SignalClass

	function Connection:Disconnect()

		if self.is_connected == false then
			return
		end

		local signal = self.signal
		self.is_connected = false
		signal.listener_count -= 1

		if signal.head == self then
			signal.head = self.next
		else
			local prev = signal.head
			while prev ~= nil and prev.next ~= self do
				prev = prev.next
			end
			if prev ~= nil then
				prev.next = self.next
			end
		end

	end

	function SignalClass.New()

		local self = {
			head = nil,
			listener_count = 0,
		}
		setmetatable(self, SignalClass)

		return self

	end

	function SignalClass:Connect(listener: (...any) -&gt; ())

		if type(listener) ~= "function" then
			error(`[{script.Name}]: \"listener\" must be a function; Received {typeof(listener)}`)
		end

		local connection = {
			listener = listener,
			signal = self,
			next = self.head,
			is_connected = true,
		}
		setmetatable(connection, Connection)

		self.head = connection
		self.listener_count += 1

		return connection

	end

	function SignalClass:GetListenerCount(): number
		return self.listener_count
	end

	function SignalClass:Fire(...)
		local item = self.head
		while item ~= nil do
			if item.is_connected == true then
				if not FreeRunnerThread then
					FreeRunnerThread = coroutine.create(RunEventHandlerInFreeThread)
				end
				task.spawn(FreeRunnerThread, item.listener, ...)
			end
			item = item.next
		end
	end

	function SignalClass:Wait()
		local co = coroutine.running()
		local connection
		connection = self:Connect(function(...)
			connection:Disconnect()
			task.spawn(co, ...)
		end)
		return coroutine.yield()
	end

	Signal = table.freeze({
		New = SignalClass.New,
	})

end

----- Private -----

local ActiveSessionCheck = {} -- {[session_token] = profile, ...}
local AutoSaveList = {} -- {profile, ...} -- Loaded profile table which will be circularly auto-saved
local IssueQueue = {} -- {issue_time, ...}

local DataStoreService = game:GetService("DataStoreService")
local MessagingService = game:GetService("MessagingService")
local HttpService = game:GetService("HttpService")
local RunService = game:GetService("RunService")

local PlaceId = game.PlaceId
local JobId = game.JobId

local AutoSaveIndex = 1 -- Next profile to auto save
local LastAutoSave = os.clock()

local LoadIndex = 0

local ActiveProfileLoadJobs = 0 -- Number of active threads that are loading in profiles
local ActiveProfileSaveJobs = 0 -- Number of active threads that are saving profiles

local CriticalStateStart = 0 -- os.clock()

local IsStudio = RunService:IsStudio()
local DataStoreState: "NotReady" | "NoInternet" | "NoAccess" | "Access" = "NotReady"

local MockStore = {}
local UserMockStore = {}
local MockFlag = false

local OnError = Signal.New() -- (message, store_name, profile_key)
local OnOverwrite = Signal.New() -- (store_name, profile_key)

local UpdateQueue = { -- For stability sake, we won't do UpdateAsync calls for the same key until all previous calls finish
	--[[
		[session_token] = {
			coroutine, ...
		},
		...
	--]]
}

local function WaitInUpdateQueue(session_token) --&gt; next_in_queue()

	local is_first = false

	if UpdateQueue[session_token] == nil then
		is_first = true
		UpdateQueue[session_token] = {}
	end

	local queue = UpdateQueue[session_token]

	if is_first == false then
		table.insert(queue, coroutine.running())
		coroutine.yield()
	end

	return function()
		local next_co = table.remove(queue, 1)
		if next_co ~= nil then
			coroutine.resume(next_co)
		else
			UpdateQueue[session_token] = nil
		end
	end

end

local function SessionToken(store_name, profile_key, is_mock)

	local session_token = "L_" -- Live

	if is_mock == true then
		session_token = "U_" -- User mock
	elseif DataStoreState ~= "Access" then
		session_token = "M_" -- Mock, cause no DataStore access
	end

	session_token ..= store_name .. "\0" .. profile_key

	return session_token

end

local function DeepCopyTable(t)
	local copy = {}
	for key, value in pairs(t) do
		if type(value) == "table" then
			copy[key] = DeepCopyTable(value)
		else
			copy[key] = value
		end
	end
	return copy
end

local function ReconcileTable(target, template)
	for k, v in pairs(template) do
		if type(k) == "string" then -- Only string keys will be reconciled
			if target[k] == nil then
				if type(v) == "table" then
					target[k] = DeepCopyTable(v)
				else
					target[k] = v
				end
			elseif type(target[k]) == "table" and type(v) == "table" then
				ReconcileTable(target[k], v)
			end
		end
	end
end

local function RegisterError(error_message, store_name, profile_key) -- Called when a DataStore API call errors
	warn(`[{script.Name}]: DataStore API error (STORE:{store_name}; KEY:{profile_key}) - {tostring(error_message)}`)
	table.insert(IssueQueue, os.clock()) -- Adding issue time to queue
	OnError:Fire(tostring(error_message), store_name, profile_key)
end

local function RegisterOverwrite(store_name, profile_key) -- Called when a corrupted profile is loaded
	warn(`[{script.Name}]: Invalid profile was overwritten (STORE:{store_name}; KEY:{profile_key})`)
	OnOverwrite:Fire(store_name, profile_key)
end

local function NewMockDataStoreKeyInfo(params)

	local version_id_string = tostring(params.VersionId or 0)
	local meta_data = params.MetaData or {}
	local user_ids = params.UserIds or {}

	return {
		CreatedTime = params.CreatedTime,
		UpdatedTime = params.UpdatedTime,
		Version = string.rep("0", 16) .. "."
			.. string.rep("0", 10 - string.len(version_id_string)) .. version_id_string
			.. "." .. string.rep("0", 16) .. "." .. "01",

		GetMetadata = function()
			return DeepCopyTable(meta_data)
		end,

		GetUserIds = function()
			return DeepCopyTable(user_ids)
		end,
	}

end

local function MockUpdateAsync(mock_data_store, profile_store_name, key, transform_function, is_get_call) --&gt; loaded_data, key_info

	local profile_store = mock_data_store[profile_store_name]

	if profile_store == nil then
		profile_store = {}
		mock_data_store[profile_store_name] = profile_store
	end

	local epoch_time = math.floor(os.time() * 1000)
	local mock_entry = profile_store[key]
	local mock_entry_was_nil = false

	if mock_entry == nil then
		mock_entry_was_nil = true
		if is_get_call ~= true then
			mock_entry = {
				Data = nil,
				CreatedTime = epoch_time,
				UpdatedTime = epoch_time,
				VersionId = 0,
				UserIds = {},
				MetaData = {},
			}
			profile_store[key] = mock_entry
		end
	end

	local mock_key_info = mock_entry_was_nil == false and NewMockDataStoreKeyInfo(mock_entry) or nil

	local transform, user_ids, roblox_meta_data = transform_function(mock_entry and mock_entry.Data, mock_key_info)

	if transform == nil then
		return nil
	else
		if mock_entry ~= nil and is_get_call ~= true then
			mock_entry.Data = DeepCopyTable(transform)
			mock_entry.UserIds = DeepCopyTable(user_ids or {})
			mock_entry.MetaData = DeepCopyTable(roblox_meta_data or {})
			mock_entry.VersionId += 1
			mock_entry.UpdatedTime = epoch_time
		end

		return DeepCopyTable(transform), mock_entry ~= nil and NewMockDataStoreKeyInfo(mock_entry) or nil
	end

end

local function UpdateAsync(profile_store, profile_key, transform_params, is_user_mock, is_get_call, version) --&gt; loaded_data, key_info
	--transform_params = {
	--	ExistingProfileHandle = function(latest_data),
	--	MissingProfileHandle = function(latest_data),
	--	EditProfile = function(latest_data),
	--}

	local loaded_data, key_info
	
	local next_in_queue = WaitInUpdateQueue(SessionToken(profile_store.Name, profile_key, is_user_mock))

	local success = true

	local success, error_message = pcall(function()
		local transform_function = function(latest_data)

			local missing_profile = false
			local overwritten = false
			local global_updates = {0, {}}

			if latest_data == nil then

				missing_profile = true

			elseif type(latest_data) ~= "table" then

				missing_profile = true
				overwritten = true

			else

				if type(latest_data.Data) == "table" and type(latest_data.MetaData) == "table" and type(latest_data.GlobalUpdates) == "table" then

					-- Regular profile structure detected:

					latest_data.WasOverwritten = false -- Must be set to false if set previously
					global_updates = latest_data.GlobalUpdates

					if transform_params.ExistingProfileHandle ~= nil then
						transform_params.ExistingProfileHandle(latest_data)
					end

				elseif latest_data.Data == nil and latest_data.MetaData == nil and type(latest_data.GlobalUpdates) == "table" then

					-- Regular structure not detected, but GlobalUpdate data exists:

					latest_data.WasOverwritten = false -- Must be set to false if set previously
					global_updates = latest_data.GlobalUpdates or global_updates
					missing_profile = true

				else

					missing_profile = true
					overwritten = true

				end

			end

			-- Profile was not created or corrupted and no GlobalUpdate data exists:
			if missing_profile == true then
				latest_data = {
					-- Data = nil,
					-- MetaData = nil,
					GlobalUpdates = global_updates,
				}
				if transform_params.MissingProfileHandle ~= nil then
					transform_params.MissingProfileHandle(latest_data)
				end
			end

			-- Editing profile:
			if transform_params.EditProfile ~= nil then
				transform_params.EditProfile(latest_data)
			end

			-- Invalid data handling (Silently override with empty profile)
			if overwritten == true then
				latest_data.WasOverwritten = true -- Temporary tag that will be removed on first save
			end

			return latest_data, latest_data.UserIds, latest_data.RobloxMetaData
		end

		if is_user_mock == true then -- Used when the profile is accessed through ProfileStore.Mock

			loaded_data, key_info = MockUpdateAsync(UserMockStore, profile_store.Name, profile_key, transform_function, is_get_call)
			task.wait() -- Simulate API call yield

		elseif DataStoreState ~= "Access" then -- Used when API access is disabled

			loaded_data, key_info = MockUpdateAsync(MockStore, profile_store.Name, profile_key, transform_function, is_get_call)
			task.wait() -- Simulate API call yield

		else

			if is_get_call == true then

				if version ~= nil then

					local success, error_message = pcall(function()
						loaded_data, key_info = profile_store.data_store:GetVersionAsync(profile_key, version)
					end)

					if success == false and type(error_message) == "string" and string.find(error_message, "not valid") ~= nil then
						warn(`[{script.Name}]: Passed version argument is not valid; Traceback:\n` .. debug.traceback())
					end

				else

					loaded_data, key_info = profile_store.data_store:GetAsync(profile_key)

				end

				loaded_data = transform_function(loaded_data)

			else

				loaded_data, key_info = profile_store.data_store:UpdateAsync(profile_key, transform_function)

			end

		end

	end)

	next_in_queue()

	if success == true and type(loaded_data) == "table" then
		-- Invalid data handling:
		if loaded_data.WasOverwritten == true and is_get_call ~= true then
			RegisterOverwrite(
				profile_store.Name,
				profile_key
			)
		end
		-- Return loaded_data:
		return loaded_data, key_info
	else
		-- Error handling:
		RegisterError(
			error_message or "Undefined error",
			profile_store.Name,
			profile_key
		)
		-- Return nothing:
		return nil
	end

end

local function IsThisSession(session_tag)
	return session_tag[1] == PlaceId and session_tag[2] == JobId
end

local function ReadMockFlag(): boolean
	local is_mock = MockFlag
	MockFlag = false
	return is_mock
end

local function WaitForStoreReady(profile_store)
	while profile_store.is_ready == false do
		task.wait()
	end
end

local function AddProfileToAutoSave(profile)

	ActiveSessionCheck[profile.session_token] = profile

	-- Add at AutoSaveIndex and move AutoSaveIndex right:

	table.insert(AutoSaveList, AutoSaveIndex, profile)

	if #AutoSaveList &gt; 1 then
		AutoSaveIndex = AutoSaveIndex + 1
	elseif #AutoSaveList == 1 then
		-- First profile created - make sure it doesn't get immediately auto saved:
		LastAutoSave = os.clock()
	end

end

local function RemoveProfileFromAutoSave(profile)

	ActiveSessionCheck[profile.session_token] = nil

	local auto_save_index = table.find(AutoSaveList, profile)

	if auto_save_index ~= nil then
		table.remove(AutoSaveList, auto_save_index)
		if auto_save_index &lt; AutoSaveIndex then
			AutoSaveIndex = AutoSaveIndex - 1 -- Table contents were moved left before AutoSaveIndex so move AutoSaveIndex left as well
		end
		if AutoSaveList[AutoSaveIndex] == nil then -- AutoSaveIndex was at the end of the AutoSaveList - reset to 1
			AutoSaveIndex = 1
		end
	end

end

local function SaveProfileAsync(profile, is_ending_session, is_overwriting, last_save_reason)

	if type(profile.Data) ~= "table" then
		error(`[{script.Name}]: Developer code likely set "Profile.Data" to a non-table value! (STORE:{profile.ProfileStore.Name}; KEY:{profile.Key})`)
	end

	profile.OnSave:Fire()
	if is_ending_session == true then
		profile.OnLastSave:Fire(last_save_reason or "Manual")
	end

	if is_ending_session == true and is_overwriting ~= true then
		if profile.roblox_message_subscription ~= nil then
			profile.roblox_message_subscription:Disconnect()
		end
		RemoveProfileFromAutoSave(profile)
		profile.OnSessionEnd:Fire()
	end

	ActiveProfileSaveJobs = ActiveProfileSaveJobs + 1

	-- Compare "SessionLoadCount" when writing to profile to prevent a rare case of repeat last save when the profile is loaded on the same server again

	local repeat_save_flag = true -- Released Profile save calls have to repeat until they succeed
	local exp_backoff = 1

	while repeat_save_flag == true do

		if is_ending_session ~= true then
			repeat_save_flag = false
		end

		local loaded_data, key_info = UpdateAsync(
			profile.ProfileStore,
			profile.Key,
			{
				ExistingProfileHandle = nil,
				MissingProfileHandle = nil,
				EditProfile = function(latest_data)
					
					-- Check if this session still owns the profile:

					local session_owns_profile = false

					if is_overwriting ~= true then

						local active_session = latest_data.MetaData.ActiveSession
						local session_load_count = latest_data.MetaData.SessionLoadCount

						if type(active_session) == "table" then
							session_owns_profile = IsThisSession(active_session) and session_load_count == profile.load_index
						end

					else
						session_owns_profile = true
					end

					-- We may only edit the profile if this server has ownership of the profile:

					if session_owns_profile == true then

						-- Clear processed updates (messages):

						local locked_updates = profile.locked_global_updates -- [index] = true, ...
						local active_updates = latest_data.GlobalUpdates[2]
						-- ProfileService module format: {{update_id, version_id, update_locked, update_data}, ...}
						-- ProfileStore module format: {{update_id, update_data}, ...}

						if next(locked_updates) ~= nil then
							local i = 1
							while i &lt;= #active_updates do
								local update = active_updates[i]
								if locked_updates[update[1]] == true then
									table.remove(active_updates, i)
								else
									i += 1
								end
							end
						end

						-- Save profile data:

						latest_data.Data = profile.Data
						latest_data.RobloxMetaData = profile.RobloxMetaData
						latest_data.UserIds = profile.UserIds

						if is_overwriting ~= true then

							latest_data.MetaData.LastUpdate = os.time()

							if is_ending_session == true then
								latest_data.MetaData.ActiveSession = nil
							end

						else

							latest_data.MetaData.ActiveSession = nil
							latest_data.MetaData.ForceLoadSession = nil

						end

					end

				end,
			},
			profile.is_mock
		)

		if loaded_data ~= nil and key_info ~= nil then

			if is_overwriting == true then
				break
			end
			
			repeat_save_flag = false
			
			local active_session = loaded_data.MetaData.ActiveSession
			local session_load_count = loaded_data.MetaData.SessionLoadCount
			local session_owns_profile = false

			if type(active_session) == "table" then
				session_owns_profile = IsThisSession(active_session) and session_load_count == profile.load_index
			end
			
			local force_load_session = loaded_data.MetaData.ForceLoadSession
			local force_load_pending = false
			if type(force_load_session) == "table" then
				force_load_pending = not IsThisSession(force_load_session)
			end
			
			local is_active = profile:IsActive()
			
			-- If another server is trying to start a session for this profile - end the session:

			if force_load_pending == true and session_owns_profile == true then
				if is_active == true then
					SaveProfileAsync(profile, true, false, "External")
				end
				break
			end
			
			-- Clearing processed update list / Detecting new updates:

			local locked_updates = profile.locked_global_updates -- [index] = true, ...
			local received_updates = profile.received_global_updates -- [index] = true, ...
			local active_updates = loaded_data.GlobalUpdates[2]

			local new_updates = {} -- {}, ...
			local still_pending = {} -- [index] = true, ...

			for _, update in ipairs(active_updates) do
				if locked_updates[update[1]] == true then
					still_pending[update[1]] = true
				elseif received_updates[update[1]] ~= true then
					received_updates[update[1]] = true
					table.insert(new_updates, update)
				end
			end

			for index in pairs(locked_updates) do
				if still_pending[index] ~= true then
					locked_updates[index] = nil
				end
			end

			-- Updating profile values:

			profile.KeyInfo = key_info
			profile.LastSavedData = loaded_data.Data
			profile.global_updates = loaded_data.GlobalUpdates and loaded_data.GlobalUpdates[2] or {}

			if session_owns_profile == true then
				if is_active == true and is_ending_session ~= true then

					-- Processing new global updates (messages):

					for _, update in ipairs(new_updates) do

						local index = update[1]
						local update_data = update[#update] -- Backwards compatibility with ProfileService

						for _, handler in ipairs(profile.message_handlers) do

							local is_processed = false
							local processed_callback = function()
								is_processed = true
								locked_updates[index] = true
							end
							
							local send_update_data = DeepCopyTable(update_data)

							task.spawn(handler, send_update_data, processed_callback)

							if is_processed == true then
								break
							end

						end

					end

				end
			else
				
				if profile.roblox_message_subscription ~= nil then
					profile.roblox_message_subscription:Disconnect()
				end

				if is_active == true then
					RemoveProfileFromAutoSave(profile)
					profile.OnSessionEnd:Fire()
				end

			end

			profile.OnAfterSave:Fire(profile.LastSavedData)

		elseif repeat_save_flag == true then
			
			-- DataStore call likely resulted in an error; Repeat the DataStore call shortly
			task.wait(exp_backoff)
			exp_backoff = math.min(if last_save_reason == "Shutdown" then 8 else 20, exp_backoff * 2)

		end

	end

	ActiveProfileSaveJobs = ActiveProfileSaveJobs - 1

end

----- Public -----

--[[
	Saved profile structure:
	
	{
		Data = {},
		
		MetaData = {
			ProfileCreateTime = 0,
			SessionLoadCount = 0,
			ActiveSession = {place_id, game_job_id, unique_session_id} / nil,
			ForceLoadSession = {place_id, game_job_id} / nil,
			LastUpdate = 0, -- os.time()
			MetaTags = {}, -- Backwards compatibility with ProfileService
		},
		
		RobloxMetaData = {},
		UserIds = {},
		
		GlobalUpdates = {
			update_index,
			{
				{update_index, data}, ...
			},
		},
	}

--]]

export type JSONAcceptable = { JSONAcceptable } | { [string]: JSONAcceptable } | number | string | boolean | buffer

export type Profile&lt;T&gt; = {
	Data: T &amp; JSONAcceptable,
	LastSavedData: T &amp; JSONAcceptable,
	FirstSessionTime: number,
	SessionLoadCount: number,
	Session: {PlaceId: number, JobId: string}?,
	RobloxMetaData: JSONAcceptable,
	UserIds: {number},
	KeyInfo: DataStoreKeyInfo,
	OnSave: {Connect: (self: any, listener: () -&gt; ()) -&gt; ({Disconnect: (self: any) -&gt; ()})},
	OnLastSave: {Connect: (self: any, listener: (reason: "Manual" | "External" | "Shutdown") -&gt; ()) -&gt; ({Disconnect: (self: any) -&gt; ()})},
	OnSessionEnd: {Connect: (self: any, listener: () -&gt; ()) -&gt; ({Disconnect: (self: any) -&gt; ()})},
	OnAfterSave: {Connect: (self: any, listener: (last_saved_data: T &amp; JSONAcceptable) -&gt; ()) -&gt; ({Disconnect: (self: any) -&gt; ()})},
	ProfileStore: JSONAcceptable,
	Key: string,

	IsActive: (self: any) -&gt; (boolean),
	Reconcile: (self: any) -&gt; (),
	EndSession: (self: any) -&gt; (),
	AddUserId: (self: any, user_id: number) -&gt; (),
	RemoveUserId: (self: any, user_id: number) -&gt; (),
	MessageHandler: (self: any, fn: (message: JSONAcceptable, processed: () -&gt; ()) -&gt; ()) -&gt; (),
	Save: (self: any) -&gt; (),
	SetAsync: (self: any) -&gt; (),
}

export type VersionQuery&lt;T&gt; = {
	NextAsync: (self: any) -&gt; (Profile&lt;T&gt;?),
}

type ProfileStoreStandard&lt;T&gt; = {
	Name: string,
	StartSessionAsync: (self: any, profile_key: string, params: {Steal: boolean?}) -&gt; (Profile&lt;T&gt;?),
	MessageAsync: (self: any, profile_key: string, message: JSONAcceptable) -&gt; (boolean),
	GetAsync: (self: any, profile_key: string, version: string?) -&gt; (Profile&lt;T&gt;?),
	VersionQuery: (self: any, profile_key: string, sort_direction: Enum.SortDirection?, min_date: DateTime | number | nil, max_date: DateTime | number | nil) -&gt; (VersionQuery&lt;T&gt;),
	RemoveAsync: (self: any, profile_key: string) -&gt; (boolean),
}

export type ProfileStore&lt;T&gt; = {
	Mock: ProfileStoreStandard&lt;T&gt;,
} &amp; ProfileStoreStandard&lt;T&gt;

type ConstantName = "AUTO_SAVE_PERIOD" | "LOAD_REPEAT_PERIOD" | "FIRST_LOAD_REPEAT" | "SESSION_STEAL"
| "ASSUME_DEAD" | "START_SESSION_TIMEOUT" | "CRITICAL_STATE_ERROR_COUNT" | "CRITICAL_STATE_ERROR_EXPIRE"
| "CRITICAL_STATE_EXPIRE" | "MAX_MESSAGE_QUEUE"

export type ProfileStoreModule = {
	IsClosing: boolean,
	IsCriticalState: boolean,
	OnError: {Connect: (self: any, listener: (message: string, store_name: string, profile_key: string) -&gt; ()) -&gt; ({Disconnect: (self: any) -&gt; ()})},
	OnOverwrite: {Connect: (self: any, listener: (store_name: string, profile_key: string) -&gt; ()) -&gt; ({Disconnect: (self: any) -&gt; ()})},
	OnCriticalToggle: {Connect: (self: any, listener: (is_critical: boolean) -&gt; ()) -&gt; ({Disconnect: (self: any) -&gt; ()})},
	DataStoreState: "NotReady" | "NoInternet" | "NoAccess" | "Access",
	New: &lt;T&gt;(store_name: string, template: (T &amp; JSONAcceptable)?) -&gt; (ProfileStore&lt;T&gt;),
	SetConstant: (name: ConstantName, value: number) -&gt; ()
}

local Profile = {}
Profile.__index = Profile

function Profile.New(raw_data, key_info, profile_store, key, is_mock, session_token)

	local data = raw_data.Data or {}
	local session = raw_data.MetaData and raw_data.MetaData.ActiveSession or nil

	local global_updates = raw_data.GlobalUpdates and raw_data.GlobalUpdates[2] or {}
	local received_global_updates = {}

	for _, update in ipairs(global_updates) do
		received_global_updates[update[1]] = true
	end

	local self = {

		Data = data,
		LastSavedData = DeepCopyTable(data),

		FirstSessionTime = raw_data.MetaData and raw_data.MetaData.ProfileCreateTime or 0,
		SessionLoadCount = raw_data.MetaData and raw_data.MetaData.SessionLoadCount or 0,
		Session = session and {PlaceId = session[1], JobId = session[2]},

		RobloxMetaData = raw_data.RobloxMetaData or {},
		UserIds = raw_data.UserIds or {},
		KeyInfo = key_info,

		OnAfterSave = Signal.New(),
		OnSave = Signal.New(),
		OnLastSave = Signal.New(),
		OnSessionEnd = Signal.New(),

		ProfileStore = profile_store,
		Key = key,

		load_timestamp = os.clock(),
		is_mock = is_mock,
		session_token = session_token or "",
		load_index = raw_data.MetaData and raw_data.MetaData.SessionLoadCount or 0,
		locked_global_updates = {},
		received_global_updates = received_global_updates,
		message_handlers = {},
		global_updates = global_updates,

	}
	setmetatable(self, Profile)

	return self

end

function Profile:IsActive()
	return ActiveSessionCheck[self.session_token] == self
end

function Profile:Reconcile()
	ReconcileTable(self.Data, self.ProfileStore.template)
end

function Profile:EndSession()
	if self:IsActive() == true then
		task.spawn(SaveProfileAsync, self, true, nil, "Manual") -- Call save function in a new thread with release_from_session = true
	end
end

function Profile:AddUserId(user_id) -- Associates user_id with profile (GDPR compliance)

	if type(user_id) ~= "number" or user_id % 1 ~= 0 then
		warn(`[{script.Name}]: Invalid UserId argument for :AddUserId() ({tostring(user_id)}); Traceback:\n` .. debug.traceback())
		return
	end

	if user_id &lt; 0 and self.is_mock ~= true and DataStoreState == "Access" then
		return -- Avoid giving real Roblox APIs negative UserId's
	end

	if table.find(self.UserIds, user_id) == nil then
		table.insert(self.UserIds, user_id)
	end

end

function Profile:RemoveUserId(user_id) -- Removes user_id association with profile (safe function)

	if type(user_id) ~= "number" or user_id % 1 ~= 0 then
		warn(`[{script.Name}]: Invalid UserId argument for :RemoveUserId() ({tostring(user_id)}); Traceback:\n` .. debug.traceback())
		return
	end

	local index = table.find(self.UserIds, user_id)

	if index ~= nil then
		table.remove(self.UserIds, index)
	end

end

function Profile:SetAsync() -- Saves the profile to the DataStore and removes the session lock

	if self.view_mode ~= true then
		error(`[{script.Name}]: :SetAsync() can only be used in view mode`)
	end

	SaveProfileAsync(self, nil, true)

end

function Profile:MessageHandler(fn)

	if type(fn) ~= "function" then
		error(`[{script.Name}]: fn argument is not a function`)
	end

	if self.view_mode ~= true and self:IsActive() ~= true then
		return -- Don't process messages if the profile session was ended
	end

	local locked_updates = self.locked_global_updates
	table.insert(self.message_handlers, fn)

	for _, update in ipairs(self.global_updates) do

		local index = update[1]
		local update_data = update[#update] -- Backwards compatibility with ProfileService

		if locked_updates[index] ~= true then

			local processed_callback = function()
				locked_updates[index] = true
			end
			
			local send_update_data = DeepCopyTable(update_data)

			task.spawn(fn, send_update_data, processed_callback)

		end

	end

end

function Profile:Save()
	
	if self.view_mode == true then
		error(`[{script.Name}]: Can't save profile in view mode; Should you be calling :SetAsync() instead?`)
	end
	
	if self:IsActive() == false then
		warn(`[{script.Name}]: Attempted saving an inactive profile (STORE:{self.ProfileStore.Name}; KEY:{self.Key});`
			.. ` Traceback:\n` .. debug.traceback())
		return
	end
	
	-- Move the profile right behind the auto save index to delay the next auto save for it:
	RemoveProfileFromAutoSave(self)
	AddProfileToAutoSave(self)
	
	-- Perform save in new thread:
	task.spawn(SaveProfileAsync, self)

end

local ProfileStore: ProfileStoreModule = {

	IsClosing = false,
	IsCriticalState = false,
	OnError = OnError, -- (message, store_name, profile_key)
	OnOverwrite = OnOverwrite, -- (store_name, profile_key)
	OnCriticalToggle = Signal.New(), -- (is_critical)
	DataStoreState = "NotReady", -- ("NotReady", "NoInternet", "NoAccess", "Access")

}
ProfileStore.__index = ProfileStore

function ProfileStore.SetConstant(name, value)

	if type(value) ~= "number" then
		error(`[{script.Name}]: Invalid value type`)
	end

	if name == "AUTO_SAVE_PERIOD" then
		AUTO_SAVE_PERIOD = value
	elseif name == "LOAD_REPEAT_PERIOD" then
		LOAD_REPEAT_PERIOD = value
	elseif name == "FIRST_LOAD_REPEAT" then
		FIRST_LOAD_REPEAT = value
	elseif name == "SESSION_STEAL" then
		SESSION_STEAL = value
	elseif name == "ASSUME_DEAD" then
		ASSUME_DEAD = value
	elseif name == "START_SESSION_TIMEOUT" then
		START_SESSION_TIMEOUT = value
	elseif name == "CRITICAL_STATE_ERROR_COUNT" then
		CRITICAL_STATE_ERROR_COUNT = value
	elseif name == "CRITICAL_STATE_ERROR_EXPIRE" then
		CRITICAL_STATE_ERROR_EXPIRE = value
	elseif name == "CRITICAL_STATE_EXPIRE" then
		CRITICAL_STATE_EXPIRE = value
	elseif name == "MAX_MESSAGE_QUEUE" then
		MAX_MESSAGE_QUEUE = value
	else
		error(`[{script.Name}]: Invalid constant name was provided`)
	end

end

function ProfileStore.Test()
	return {
		ActiveSessionCheck = ActiveSessionCheck,
		AutoSaveList = AutoSaveList,
		ActiveProfileLoadJobs = ActiveProfileLoadJobs,
		ActiveProfileSaveJobs = ActiveProfileSaveJobs,
		MockStore = MockStore,
		UserMockStore = UserMockStore,
		UpdateQueue = UpdateQueue,
	}
end

function ProfileStore.New(store_name, template)

	template = template or {}

	if type(store_name) ~= "string" then
		error(`[{script.Name}]: Invalid or missing "store_name"`)
	elseif string.len(store_name) == 0 then
		error(`[{script.Name}]: store_name cannot be an empty string`)
	elseif string.len(store_name) &gt; 50 then
		error(`[{script.Name}]: store_name is too long`)
	end

	if type(template) ~= "table" then
		error(`[{script.Name}]: Invalid template argument`)
	end

	local self
	self = {

		Mock = {

			Name = store_name,

			StartSessionAsync = function(_, profile_key)
				MockFlag = true
				return self:StartSessionAsync(profile_key)
			end,
			MessageAsync = function(_, profile_key, message)
				MockFlag = true
				return self:MessageAsync(profile_key, message)
			end,
			GetAsync = function(_, profile_key, version)
				MockFlag = true
				return self:GetAsync(profile_key, version)
			end,
			VersionQuery = function(_, profile_key, sort_direction, min_date, max_date)
				MockFlag = true
				return self:VersionQuery(profile_key, sort_direction, min_date, max_date)
			end,
			RemoveAsync = function(_, profile_key)
				MockFlag = true
				return self:RemoveAsync(profile_key)
			end
		},

		Name = store_name,

		template = template,
		data_store = nil,
		load_jobs = {},
		mock_load_jobs = {},
		is_ready = true,

	}
	setmetatable(self, ProfileStore)

	local options = Instance.new("DataStoreOptions")
	options:SetExperimentalFeatures({v2 = true})

	if DataStoreState == "NotReady" then

		-- The module is not sure whether DataStores are accessible yet:

		self.is_ready = false

		task.spawn(function()

			repeat task.wait() until DataStoreState ~= "NotReady"

			if DataStoreState == "Access" then
				self.data_store = DataStoreService:GetDataStore(store_name, nil, options)
			end

			self.is_ready = true

		end)

	elseif DataStoreState == "Access" then

		self.data_store = DataStoreService:GetDataStore(store_name, nil, options)

	end

	return self

end

local function RobloxMessageSubscription(profile, unique_session_id)

	local last_roblox_message = 0
	
	local roblox_message_subscription = MessagingService:SubscribeAsync("PS_" .. unique_session_id, function(message)
		if type(message.Data) == "table" and message.Data.LoadCount == profile.SessionLoadCount then
			-- High reaction rate, based on numPlayers × 10 DataStore budget as of writing
			if os.clock() - last_roblox_message &gt; 6 then 
				last_roblox_message = os.clock()
				if profile:IsActive() == true then
					if message.Data.EndSession == true then
						SaveProfileAsync(profile, true, false, "External")
					else
						profile:Save()
					end
				end
			end
		end
	end)

	if profile:IsActive() == true then
		profile.roblox_message_subscription = roblox_message_subscription
	else
		roblox_message_subscription:Disconnect()
	end

end

function ProfileStore:StartSessionAsync(profile_key, params)

	local is_mock = ReadMockFlag()

	if type(profile_key) ~= "string" then
		error(`[{script.Name}]: profile_key must be a string`)
	elseif string.len(profile_key) == 0 then
		error(`[{script.Name}]: Invalid profile_key`)
	elseif string.len(profile_key) &gt; 50 then
		error(`[{script.Name}]: profile_key is too long`)
	end
	
	if params ~= nil and type(params) ~= "table" then
		error(`[{script.Name}]: Invalid params`)
	end
	
	params = params or {}

	if ProfileStore.IsClosing == true then
		return nil
	end
	
	WaitForStoreReady(self)

	local session_token = SessionToken(self.Name, profile_key, is_mock)

	if ActiveSessionCheck[session_token] ~= nil then
		error(`[{script.Name}]: Profile (STORE:{self.Name}; KEY:{profile_key}) is already loaded in this session`)
	end

	ActiveProfileLoadJobs = ActiveProfileLoadJobs + 1
	
	local is_user_cancel = false
	
	local function cancel_condition()
		if is_user_cancel == false then
			if params.Cancel ~= nil then
				is_user_cancel = params.Cancel() == true
			end
			return is_user_cancel
		end
		return true
	end
	
	local user_steal = params.Steal == true

	local force_load_steps = 0 -- Session conflict handling values
	local request_force_load = true
	local steal_session = false

	local start = os.clock()
	local exp_backoff = 1

	while ProfileStore.IsClosing == false and cancel_condition() == false do

		-- Load profile:

		-- SPECIAL CASE - If StartSessionAsync is called for the same key again before another StartSessionAsync finishes,
		-- grab the DataStore return for the new call. The early call will return nil. This is supposed to retain
		-- expected and efficient behavior in cases where a player would quickly rejoin the same server.

		LoadIndex += 1
		local load_id = LoadIndex
		local profile_load_jobs = is_mock == true and self.mock_load_jobs or self.load_jobs
		local profile_load_job = profile_load_jobs[profile_key] -- {load_id, {loaded_data, key_info} or nil}

		local loaded_data, key_info
		local unique_session_id = HttpService:GenerateGUID(false)

		if profile_load_job ~= nil then

			profile_load_job[1] = load_id -- Steal load job
			while profile_load_job[2] == nil do -- Wait for job to finish
				task.wait()
			end
			if profile_load_job[1] == load_id then -- Load job hasn't been double-stolen
				loaded_data, key_info = table.unpack(profile_load_job[2])
				profile_load_jobs[profile_key] = nil
			else
				ActiveProfileLoadJobs = ActiveProfileLoadJobs - 1
				return nil
			end

		else

			profile_load_job = {load_id, nil}
			profile_load_jobs[profile_key] = profile_load_job

			profile_load_job[2] = table.pack(UpdateAsync(
				self,
				profile_key,
				{
					ExistingProfileHandle = function(latest_data)

						if ProfileStore.IsClosing == true or cancel_condition() == true then
							return
						end

						local active_session = latest_data.MetaData.ActiveSession
						local force_load_session = latest_data.MetaData.ForceLoadSession

						if active_session == nil then
							latest_data.MetaData.ActiveSession = {PlaceId, JobId, unique_session_id}
							latest_data.MetaData.ForceLoadSession = nil
						elseif type(active_session) == "table" then
							if IsThisSession(active_session) == false then
								local last_update = latest_data.MetaData.LastUpdate
								if last_update ~= nil then
									if os.time() - last_update &gt; ASSUME_DEAD then
										latest_data.MetaData.ActiveSession = {PlaceId, JobId, unique_session_id}
										latest_data.MetaData.ForceLoadSession = nil
										return
									end
								end
								if steal_session == true or user_steal == true then
									local force_load_interrupted = if force_load_session ~= nil then not IsThisSession(force_load_session) else true
									if force_load_interrupted == false or user_steal == true then
										latest_data.MetaData.ActiveSession = {PlaceId, JobId, unique_session_id}
										latest_data.MetaData.ForceLoadSession = nil
									end
								elseif request_force_load == true then
									latest_data.MetaData.ForceLoadSession = {PlaceId, JobId}
								end
							else
								latest_data.MetaData.ForceLoadSession = nil
							end
						end

					end,
					MissingProfileHandle = function(latest_data)
						
						local is_cancel = ProfileStore.IsClosing == true or cancel_condition() == true

						latest_data.Data = DeepCopyTable(self.template)
						latest_data.MetaData = {
							ProfileCreateTime = os.time(),
							SessionLoadCount = 0,
							ActiveSession = if is_cancel == false then {PlaceId, JobId, unique_session_id} else nil,
							ForceLoadSession = nil,
							MetaTags = {}, -- Backwards compatibility with ProfileService
						}

					end,
					EditProfile = function(latest_data)

						if ProfileStore.IsClosing == true or cancel_condition() == true then
							return
						end

						local active_session = latest_data.MetaData.ActiveSession
						if active_session ~= nil and IsThisSession(active_session) == true then
							latest_data.MetaData.SessionLoadCount = latest_data.MetaData.SessionLoadCount + 1
							latest_data.MetaData.LastUpdate = os.time()
						end

					end,
				},
				is_mock
				))
			if profile_load_job[1] == load_id then -- Load job hasn't been stolen
				loaded_data, key_info = table.unpack(profile_load_job[2])
				profile_load_jobs[profile_key] = nil
			else
				ActiveProfileLoadJobs = ActiveProfileLoadJobs - 1
				return nil -- Load job stolen
			end
		end

		-- Handle load_data:

		if loaded_data ~= nil and key_info ~= nil then
			local active_session = loaded_data.MetaData.ActiveSession
			if type(active_session) == "table" then

				if IsThisSession(active_session) == true then

					-- Profile is now taken by this session:

					local profile = Profile.New(loaded_data, key_info, self, profile_key, is_mock, session_token)
					AddProfileToAutoSave(profile)
					
					if is_mock ~= true and DataStoreState == "Access" then
						
						-- Use MessagingService to quickly detect session conflicts and resolve them quickly:
						task.spawn(RobloxMessageSubscription, profile, unique_session_id) -- Blocking prevention
						
					end

					if ProfileStore.IsClosing == true or cancel_condition() == true then
						-- The server has initiated a shutdown by the time this profile was loaded
						SaveProfileAsync(profile, true) -- Release profile and yield until the DataStore call is finished
						profile = nil -- Don't return the profile object
					end

					ActiveProfileLoadJobs = ActiveProfileLoadJobs - 1
					return profile

				else
					
					if ProfileStore.IsClosing == true or cancel_condition() == true then
						ActiveProfileLoadJobs = ActiveProfileLoadJobs - 1
						return nil
					end

					-- Profile is taken by some other session:

					local force_load_session = loaded_data.MetaData.ForceLoadSession
					local force_load_interrupted = if force_load_session ~= nil then not IsThisSession(force_load_session) else true

					if force_load_interrupted == false then

						if request_force_load == false then
							force_load_steps = force_load_steps + 1
							if force_load_steps &gt;= math.ceil(SESSION_STEAL / LOAD_REPEAT_PERIOD) then
								steal_session = true
							end
						end
						
						-- Request the remote server to end its session:
						if type(active_session[3]) == "string" then
							local session_load_count = loaded_data.MetaData.SessionLoadCount or 0
							task.spawn(MessagingService.PublishAsync, MessagingService, "PS_" .. active_session[3], {LoadCount = session_load_count, EndSession = true})
						end
						
						-- Attempt to load the profile again after a delay
						local wait_until = os.clock() + if request_force_load == true then FIRST_LOAD_REPEAT else LOAD_REPEAT_PERIOD
						repeat task.wait() until os.clock() &gt;= wait_until or ProfileStore.IsClosing == true

					else
						-- Another session tried to load this profile:
						ActiveProfileLoadJobs = ActiveProfileLoadJobs - 1
						return nil
					end

					request_force_load = false -- Only request a force load once

				end

			else
				ActiveProfileLoadJobs = ActiveProfileLoadJobs - 1
				return nil -- In this scenario it is likely that this server started shutting down
			end
		else
			
			-- A DataStore call has likely ended in an error:

			local default_timeout = false

			if params.Cancel == nil then
				default_timeout = os.clock() - start &gt;= START_SESSION_TIMEOUT
			end
			
			if default_timeout == true or ProfileStore.IsClosing == true or cancel_condition() == true then
				ActiveProfileLoadJobs = ActiveProfileLoadJobs - 1
				return nil
			end
			
			task.wait(exp_backoff)  -- Repeat the call shortly
			exp_backoff = math.min(20, exp_backoff * 2)
			
		end

	end

	ActiveProfileLoadJobs = ActiveProfileLoadJobs - 1
	return nil -- Game started shutting down or the request was cancelled - don't return the profile

end

function ProfileStore:MessageAsync(profile_key, message)

	local is_mock = ReadMockFlag()

	if type(profile_key) ~= "string" then
		error(`[{script.Name}]: profile_key must be a string`)
	elseif string.len(profile_key) == 0 then
		error(`[{script.Name}]: Invalid profile_key`)
	elseif string.len(profile_key) &gt; 50 then
		error(`[{script.Name}]: profile_key is too long`)
	end

	if type(message) ~= "table" then
		error(`[{script.Name}]: message must be a table`)
	end

	if ProfileStore.IsClosing == true then
		return false
	end

	WaitForStoreReady(self)

	local exp_backoff = 1

	while ProfileStore.IsClosing == false do

		-- Updating profile:

		local loaded_data = UpdateAsync(
			self,
			profile_key,
			{
				ExistingProfileHandle = nil,
				MissingProfileHandle = nil,
				EditProfile = function(latest_data)

					local global_updates = latest_data.GlobalUpdates
					local update_list = global_updates[2]
					--{
					--	update_index,
					--	{
					--		{update_index, data}, ...
					--	},
					--},

					global_updates[1] += 1
					table.insert(update_list, {global_updates[1], message})

					-- Clearing queue if above limit:

					while #update_list &gt; MAX_MESSAGE_QUEUE do
						table.remove(update_list, 1)
					end

				end,
			},
			is_mock
		)

		if loaded_data ~= nil then
			
			local session_token = SessionToken(self.Name, profile_key, is_mock)
			
			local profile = ActiveSessionCheck[session_token]
			
			if profile ~= nil then
				
				-- The message was sent to a profile that is active in this server:
				profile:Save()
				
			else
				
				local meta_data = loaded_data.MetaData or {}
				local active_session = meta_data.ActiveSession
				local session_load_count = meta_data.SessionLoadCount or 0
				
				if type(active_session) == "table" and type(active_session[3]) == "string" then
					-- Request the remote server to auto-save sooner and receive the message:
					task.spawn(MessagingService.PublishAsync, MessagingService, "PS_" .. active_session[3], {LoadCount = session_load_count})
				end
				
			end

			return true

		else

			task.wait(exp_backoff) -- A DataStore call has likely ended in an error - repeat the call shortly
			exp_backoff = math.min(20, exp_backoff * 2)

		end

	end

	return false

end

function ProfileStore:GetAsync(profile_key, version)

	local is_mock = ReadMockFlag()

	if type(profile_key) ~= "string" then
		error(`[{script.Name}]: profile_key must be a string`)
	elseif string.len(profile_key) == 0 then
		error(`[{script.Name}]: Invalid profile_key`)
	elseif string.len(profile_key) &gt; 50 then
		error(`[{script.Name}]: profile_key is too long`)
	end

	if ProfileStore.IsClosing == true then
		return nil
	end

	WaitForStoreReady(self)

	if version ~= nil and (is_mock or DataStoreState ~= "Access") then
		return nil -- No version support in mock mode
	end

	local exp_backoff = 1

	while ProfileStore.IsClosing == false do

		-- Load profile:

		local loaded_data, key_info = UpdateAsync(
			self,
			profile_key,
			{
				ExistingProfileHandle = nil,
				MissingProfileHandle = function(latest_data)

					latest_data.Data = DeepCopyTable(self.template)
					latest_data.MetaData = {
						ProfileCreateTime = os.time(),
						SessionLoadCount = 0,
						ActiveSession = nil,
						ForceLoadSession = nil,
						MetaTags = {}, -- Backwards compatibility with ProfileService
					}

				end,
				EditProfile = nil,
			},
			is_mock,
			true, -- Use :GetAsync()
			version -- DataStore key version
		)

		-- Handle load_data:

		if loaded_data ~= nil then

			if key_info == nil then
				return nil -- Load was successful, but the key was empty - return no profile object
			end

			local profile = Profile.New(loaded_data, key_info, self, profile_key, is_mock)
			profile.view_mode = true

			return profile

		else

			task.wait(exp_backoff) -- A DataStore call has likely ended in an error - repeat the call shortly
			exp_backoff = math.min(20, exp_backoff * 2)

		end

	end

	return nil -- Game started shutting down - don't return the profile

end

function ProfileStore:RemoveAsync(profile_key)

	local is_mock = ReadMockFlag()

	if type(profile_key) ~= "string" or string.len(profile_key) == 0 then
		error(`[{script.Name}]: Invalid profile_key`)
	end

	if ProfileStore.IsClosing == true then
		return false
	end

	WaitForStoreReady(self)

	local wipe_status = false
	
	local next_in_queue = WaitInUpdateQueue(SessionToken(self.Name, profile_key, is_mock))

	if is_mock == true then -- Used when the profile is accessed through ProfileStore.Mock

		local mock_data_store = UserMockStore[self.Name]

		if mock_data_store ~= nil then
			mock_data_store[profile_key] = nil
			if next(mock_data_store) == nil then
				UserMockStore[self.Name] = nil
			end
		end

		wipe_status = true
		task.wait() -- Simulate API call yield

	elseif DataStoreState ~= "Access" then -- Used when API access is disabled

		local mock_data_store = MockStore[self.Name]

		if mock_data_store ~= nil then
			mock_data_store[profile_key] = nil
			if next(mock_data_store) == nil then
				MockStore[self.Name] = nil
			end
		end

		wipe_status = true
		task.wait() -- Simulate API call yield

	else -- Live DataStore

		wipe_status = pcall(function()
			self.data_store:RemoveAsync(profile_key)
		end)

	end
	
	next_in_queue()

	return wipe_status

end

local ProfileVersionQuery = {}
ProfileVersionQuery.__index = ProfileVersionQuery

function ProfileVersionQuery.New(profile_store, profile_key, sort_direction, min_date, max_date, is_mock)

	local self = {
		profile_store = profile_store,
		profile_key = profile_key,
		sort_direction = sort_direction,
		min_date = min_date,
		max_date = max_date,

		query_pages = nil,
		query_index = 0,
		query_failure = false,

		is_query_yielded = false,
		query_queue = {},

		is_mock = is_mock,
	}
	setmetatable(self, ProfileVersionQuery)

	return self

end

function MoveVersionQueryQueue(self) -- Hidden ProfileVersionQuery method
	while #self.query_queue &gt; 0 do

		local queue_entry = table.remove(self.query_queue, 1)

		task.spawn(queue_entry)

		if self.is_query_yielded == true then
			break
		end

	end
end

local VersionQueryNextAsyncStackingFlag = false
local WarnAboutVersionQueryOnce = false

function ProfileVersionQuery:NextAsync()

	local is_stacking = VersionQueryNextAsyncStackingFlag == true
	VersionQueryNextAsyncStackingFlag = false

	WaitForStoreReady(self.profile_store)

	if ProfileStore.IsClosing == true then
		return nil -- Silently fail :NextAsync() requests
	end

	if self.is_mock == true or DataStoreState ~= "Access" then
		if IsStudio == true and WarnAboutVersionQueryOnce == false then
			WarnAboutVersionQueryOnce = true
			warn(`[{script.Name}]: :VersionQuery() is not supported in mock mode!`)
		end
		return nil -- Silently fail :NextAsync() requests
	end

	local profile
	local is_finished = false

	local function query_job()

		if self.query_failure == true then
			is_finished = true
			return
		end

		-- First "next" call loads version pages:

		if self.query_pages == nil then

			self.is_query_yielded = true

			task.spawn(function()
				VersionQueryNextAsyncStackingFlag = true
				profile = self:NextAsync()
				is_finished = true
			end)

			local list_success, error_message = pcall(function()
				self.query_pages = self.profile_store.data_store:ListVersionsAsync(
					self.profile_key,
					self.sort_direction,
					self.min_date,
					self.max_date
				)
				self.query_index = 0
			end)

			if list_success == false or self.query_pages == nil then
				warn(`[{script.Name}]: Version query fail - {tostring(error_message)}`)
				self.query_failure = true
			end

			self.is_query_yielded = false

			MoveVersionQueryQueue(self)

			return

		end

		local current_page = self.query_pages:GetCurrentPage()
		local next_item = current_page[self.query_index + 1]

		-- No more entries:

		if self.query_pages.IsFinished == true and next_item == nil then
			is_finished = true
			return
		end

		-- Load next page when this page is over:

		if next_item == nil then

			self.is_query_yielded = true
			task.spawn(function()
				VersionQueryNextAsyncStackingFlag = true
				profile = self:NextAsync()
				is_finished = true
			end)

			local success, error_message = pcall(function()
				self.query_pages:AdvanceToNextPageAsync()
				self.query_index = 0
			end)

			if success == false or #self.query_pages:GetCurrentPage() == 0 then
				self.query_failure = true
			end

			self.is_query_yielded = false
			MoveVersionQueryQueue(self)

			return

		end

		-- Next page item:

		self.query_index += 1
		profile = self.profile_store:GetAsync(self.profile_key, next_item.Version)
		is_finished = true

	end

	if self.is_query_yielded == false then
		query_job()
	else
		if is_stacking == true then
			table.insert(self.query_queue, 1, query_job)
		else
			table.insert(self.query_queue, query_job)
		end
	end

	while is_finished == false do
		task.wait()
	end

	return profile

end

function ProfileStore:VersionQuery(profile_key, sort_direction, min_date, max_date)

	local is_mock = ReadMockFlag()

	if type(profile_key) ~= "string" or string.len(profile_key) == 0 then
		error(`[{script.Name}]: Invalid profile_key`)
	end

	-- Type check:

	if sort_direction ~= nil and (typeof(sort_direction) ~= "EnumItem"
		or sort_direction.EnumType ~= Enum.SortDirection) then
		error(`[{script.Name}]: Invalid sort_direction ({tostring(sort_direction)})`)
	end

	if min_date ~= nil and typeof(min_date) ~= "DateTime" and typeof(min_date) ~= "number" then
		error(`[{script.Name}]: Invalid min_date ({tostring(min_date)})`)
	end

	if max_date ~= nil and typeof(max_date) ~= "DateTime" and typeof(max_date) ~= "number" then
		error(`[{script.Name}]: Invalid max_date ({tostring(max_date)})`)
	end

	min_date = typeof(min_date) == "DateTime" and min_date.UnixTimestampMillis or min_date
	max_date = typeof(max_date) == "DateTime" and max_date.UnixTimestampMillis or max_date

	return ProfileVersionQuery.New(self, profile_key, sort_direction, min_date, max_date, is_mock)

end

-- DataStore API access check:

if IsStudio == true then

	task.spawn(function()

		local new_state = "NoAccess"

		local status, message = pcall(function()
			-- This will error if current instance has no Studio API access:
			DataStoreService:GetDataStore("____PS"):SetAsync("____PS", os.time())
		end)

		local no_internet_access = status == false and string.find(message, "ConnectFail", 1, true) ~= nil

		if no_internet_access == true then
			warn(`[{script.Name}]: No internet access - check your network connection`)
		end

		if status == false and
			(string.find(message, "403", 1, true) ~= nil or -- Cannot write to DataStore from studio if API access is not enabled
				string.find(message, "must publish", 1, true) ~= nil or -- Game must be published to access live keys
				no_internet_access == true) then -- No internet access

			new_state = if no_internet_access == true then "NoInternet" else "NoAccess"
			print(`[{script.Name}]: Roblox API services unavailable - data will not be saved`)
		else
			new_state = "Access"
			print(`[{script.Name}]: Roblox API services available - data will be saved`)
		end

		DataStoreState = new_state
		ProfileStore.DataStoreState = new_state

	end)

else
	
	DataStoreState = "Access"
	ProfileStore.DataStoreState = "Access"
	
end

-- Update loop:

RunService.Heartbeat:Connect(function()

	-- Auto saving:

	local auto_save_list_length = #AutoSaveList
	if auto_save_list_length &gt; 0 then
		local auto_save_index_speed = AUTO_SAVE_PERIOD / auto_save_list_length
		local os_clock = os.clock()
		while os_clock - LastAutoSave &gt; auto_save_index_speed do
			LastAutoSave = LastAutoSave + auto_save_index_speed
			local profile = AutoSaveList[AutoSaveIndex]
			if os_clock - profile.load_timestamp &lt; AUTO_SAVE_PERIOD / 2 then
				-- This profile is freshly loaded - auto saving immediately is not necessary:
				profile = nil
				for _ = 1, auto_save_list_length - 1 do
					-- Move auto save index to the right:
					AutoSaveIndex = AutoSaveIndex + 1
					if AutoSaveIndex &gt; auto_save_list_length then
						AutoSaveIndex = 1
					end
					profile = AutoSaveList[AutoSaveIndex]
					if os_clock - profile.load_timestamp &gt;= AUTO_SAVE_PERIOD / 2 then
						break
					else
						profile = nil
					end
				end
			end
			-- Move auto save index to the right:
			AutoSaveIndex = AutoSaveIndex + 1
			if AutoSaveIndex &gt; auto_save_list_length then
				AutoSaveIndex = 1
			end
			-- Perform save call:
			if profile ~= nil then
				task.spawn(SaveProfileAsync, profile) -- Auto save profile in new thread
			end
		end
	end

	-- Critical state handling:

	if ProfileStore.IsCriticalState == false then
		if #IssueQueue &gt;= CRITICAL_STATE_ERROR_COUNT then
			ProfileStore.IsCriticalState = true
			ProfileStore.OnCriticalToggle:Fire(true)
			CriticalStateStart = os.clock()
			warn(`[{script.Name}]: Entered critical state`)
		end
	else
		if #IssueQueue &gt;= CRITICAL_STATE_ERROR_COUNT then
			CriticalStateStart = os.clock()
		elseif os.clock() - CriticalStateStart &gt; CRITICAL_STATE_EXPIRE then
			ProfileStore.IsCriticalState = false
			ProfileStore.OnCriticalToggle:Fire(false)
			warn(`[{script.Name}]: Critical state ended`)
		end
	end

	-- Issue queue:

	while true do
		local issue_time = IssueQueue[1]
		if issue_time == nil then
			break
		elseif os.clock() - issue_time &gt; CRITICAL_STATE_ERROR_EXPIRE then
			table.remove(IssueQueue, 1)
		else
			break
		end
	end

end)

-- Release all loaded profiles when the server is shutting down:

task.spawn(function()

	while DataStoreState == "NotReady" do
		task.wait()
	end

	if DataStoreState ~= "Access" then

		game:BindToClose(function()
			ProfileStore.IsClosing = true
			task.wait() -- Mock shutdown delay
		end)

		return -- Don't wait for profiles to properly save in mock mode so studio could end the simulation faster

	end

	game:BindToClose(function()

		ProfileStore.IsClosing = true

		-- Release all active profiles:
		-- (Clone AutoSaveList to a new table because AutoSaveList changes when profiles are released)

		local on_close_save_job_count = 0
		local active_profiles = {}
		for index, profile in ipairs(AutoSaveList) do
			active_profiles[index] = profile
		end

		-- Release the profiles; Releasing profiles can trigger listeners that release other profiles, so check active state:
		for _, profile in ipairs(active_profiles) do
			if profile:IsActive() == true then
				on_close_save_job_count = on_close_save_job_count + 1
				task.spawn(function() -- Save profile on new thread
					SaveProfileAsync(profile, true, nil, "Shutdown")
					on_close_save_job_count = on_close_save_job_count - 1
				end)
			end
		end

		-- Yield until all active profile jobs are finished:
		while on_close_save_job_count &gt; 0 or ActiveProfileLoadJobs &gt; 0 or ActiveProfileSaveJobs &gt; 0 do
			task.wait()
		end

		return -- We're done!

	end)

end)

return ProfileStore</string>
